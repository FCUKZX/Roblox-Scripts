-- ========== Serializer ==========
local function enc(v)
    local t = typeof(v)
    if t == "number" or t == "string" or t == "boolean" then
        return v
    elseif t == "Vector3" then
        return { __t = "V3", x = v.X, y = v.Y, z = v.Z }
    elseif t == "Vector2" then
        return { __t = "V2", x = v.X, y = v.Y }
    elseif t == "CFrame" then
        return { __t = "CF", c = { v:GetComponents() } }
    elseif t == "Color3" then
        return { __t = "C3", r = v.R, g = v.G, b = v.B }
    elseif t == "table" then
        local isArray = #v > 0
        if isArray then
            for k in pairs(v) do
                if type(k) ~= "number" then isArray = false break end
            end
        end
        if isArray then
            local o = {}
            for i, x in ipairs(v) do o[i] = enc(x) end
            return o
        end
        local d = {}
        for k, x in pairs(v) do
            d[type(k) == "number" and ("#" .. k) or tostring(k)] = enc(x)
        end
        return { __t = "D", d = d }
    end
    return nil
end

local function dec(v)
    if type(v) ~= "table" then return v end
    local t = v.__t
    if t == "V3" then return Vector3.new(v.x, v.y, v.z)
    elseif t == "V2" then return Vector2.new(v.x, v.y)
    elseif t == "CF" then return CFrame.new(table.unpack(v.c))
    elseif t == "C3" then return Color3.new(v.r, v.g, v.b)
    elseif t == "D" then
        local o = {}
        for k, x in pairs(v.d) do
            local key = k
            if k:sub(1, 1) == "#" then key = tonumber(k:sub(2)) or k end
            o[key] = dec(x)
        end
        return o
    end
    local o = {}
    for i, x in ipairs(v) do o[i] = dec(x) end
    return o
end

