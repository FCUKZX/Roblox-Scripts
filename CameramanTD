-- ========== ตัวช่วยแปลงค่าเป็นข้อความสั้น (ใช้ใน Log) ==========
local function short(v, depth)
    depth = depth or 0
    local t = typeof(v)
    if t == "string" then
        return '"' .. (#v > 40 and (v:sub(1, 40) .. "…") or v) .. '"'
    elseif t == "number" then
        return string.format("%.4g", v)
    elseif t == "boolean" or t == "nil" then
        return tostring(v)
    elseif t == "Vector3" then
        return string.format("V3(%.1f,%.1f,%.1f)", v.X, v.Y, v.Z)
    elseif t == "CFrame" then
        local p = v.Position
        return string.format("CF(%.1f,%.1f,%.1f)", p.X, p.Y, p.Z)
    elseif t == "Instance" then
        return "<" .. v.Name .. ">"
    elseif t == "table" then
        if depth >= 3 then return "{…}" end
        local parts, n = {}, 0
        for k, x in pairs(v) do
            n = n + 1
            if n > 8 then parts[#parts + 1] = "…" break end
            parts[#parts + 1] = (type(k) == "number" and "" or (tostring(k) .. "=")) .. short(x, depth + 1)
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return "<" .. t .. ">"
end

local function shortArgs(args)
    local out = {}
    for i = 1, args.n do out[i] = short(args[i], 0) end
    local s = table.concat(out, " | ")
    if #s > 220 then s = s:sub(1, 220) .. "…" end
    return s
end

