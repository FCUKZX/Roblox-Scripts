-- ---------- Auto สุ่มตัวกำหนดเอง (ปุ่มเดียวกับในลอบบี้) ----------
-- ทุกครึ่งชั่วโมง (:00 / :30) ตู้รีเซ็ต -> สคริปต์พาไปลอบบี้ -> สุ่มตัวที่เลือก -> กลับมาเล่นมาโครต่อ
do
-- จำ "ช่วงครึ่งชั่วโมงที่จัดการไปแล้ว" ลงไฟล์ (แยกตามบัญชี)
--   ของเดิมจำไว้แค่ในตัวแปร พอเกมจบกด PlayAgain เกมย้ายเซิร์ฟ สคริปต์เริ่มใหม่ ค่าก็หาย
--   สคริปต์เลยลืมว่าตู้เพิ่งรีเซ็ต -> ไม่ยอมไปลอบบี้  ตอนนี้จำข้ามการย้ายเซิร์ฟได้แล้ว
local SLOT_KEY = "SUMMON_SLOT_" .. tostring(player.UserId)

local function sumReadSlot()
    local ok, d = pcall(function()
        if isfile and readfile and isfile(SETTINGS_FILE) then
            return HttpService:JSONDecode(readfile(SETTINGS_FILE))
        end
    end)
    local v = ok and type(d) == "table" and tonumber(d[SLOT_KEY]) or nil
    return v or tonumber(genv.__PexSumSlot)
end

local function sumWriteSlot(slot)
    genv.__PexSumSlot = slot   -- สำรองไว้ เผื่อ executor ไม่มีระบบไฟล์
    if not writefile then return end
    pcall(function()
        local data = {}
        if isfile and readfile and isfile(SETTINGS_FILE) then
            local d = HttpService:JSONDecode(readfile(SETTINGS_FILE))
            if type(d) == "table" then data = d end   -- อ่านใหม่ทุกครั้ง เก็บค่าอื่นไว้เหมือนเดิม
        end
        data[SLOT_KEY] = slot
        writefile(SETTINGS_FILE, HttpService:JSONEncode(data))
    end)
end

do
    -- เริ่มสคริปต์: ถ้าค่าที่จำไว้เก่ามาก (เกิน 1 ชั่วโมง) ถือว่าเริ่มนับใหม่ ไม่งั้นเปิดเกมแล้วจะวิ่งไปลอบบี้ทันที
    local now = os.time() // 1800
    local saved = sumReadSlot()
    if saved == nil or now - saved > 2 or saved > now then
        saved = now
        sumWriteSlot(saved)
    end
    TD.sumSlot = saved   -- ช่วงครึ่งชั่วโมงล่าสุดที่จัดการแล้ว (ถ้าต่างจากตอนนี้ = ตู้รีเซ็ตแล้ว ยังไม่ได้ไป)
end

