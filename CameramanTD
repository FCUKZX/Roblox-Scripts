        -- ScreenGui ที่ IgnoreGuiInset = true พิกัดเป็นพิกัดจอจริงอยู่แล้ว ห้ามบวก inset (ไม่งั้นคลิกเลื่อนลงไปโดนปุ่มข้างเคียง)
        local gui = btn:FindFirstAncestorWhichIsA("ScreenGui")
        local insetY = (gui and gui.IgnoreGuiInset) and 0 or GuiService:GetGuiInset().Y
        local x = pos.X + size.X / 2
        local y = pos.Y + size.Y / 2 + insetY
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
    return ok
end

-- attempt เลขคี่ = วิธี 1 / เลขคู่ = วิธี 2 (สลับกันเผื่อวิธีใดวิธีหนึ่งไม่ติด)
local function pressObj(obj, tag, attempt)
    local btn = clickable(obj)
    if (attempt or 1) % 2 == 1 then
        if clickButton(btn) then return true end
        return mouseClick(btn)
    end
    if mouseClick(btn) then return true end
    return clickButton(btn)
end

