    -- unitRef ของอัปเกรดคือ "เลขแถวของ Place" -> ย้าย/แทรกแล้วต้องแก้เลขตาม
    local function remapRefs(fn)
        for _, a in ipairs(recordedActions) do
            if TD.isRef(a) and a.unitRef then a.unitRef = fn(a.unitRef) end
        end
    end

    local function moveAction(i, dir)
        local j = i + dir
        if j < 1 or j > #recordedActions then return false end
        recordedActions[i], recordedActions[j] = recordedActions[j], recordedActions[i]
        remapRefs(function(r)
            if r == i then return j elseif r == j then return i end
            return r
        end)
        macroDirty = true
        ui.editSel = j
        return true
    end

    local function insertAction(pos, action)
        table.insert(recordedActions, pos, action)
        for _, a in ipairs(recordedActions) do
            if a ~= action and TD.isRef(a) and a.unitRef and a.unitRef >= pos then
                a.unitRef = a.unitRef + 1
            end
        end
        macroDirty = true
    end

    sMove:Actions({
        {
            Text = "ขึ้น", Icon = "arrow-up", Color = PT.Blue,
