local function isGuid(s)
    return type(s) == "string" and #s == 36 and string.match(s, "^%x+%-%x+%-%x+%-%x+%-%x+$") ~= nil
end

local function addCand(c)
    c.t = c.t or os.clock()
    TD.cands[#TD.cands + 1] = c
    local now = os.clock()
    while #TD.cands > 80 or (TD.cands[1] and now - TD.cands[1].t > 60) do
        table.remove(TD.cands, 1)
    end
end

local function instPos(inst)
