-- รองรับข้อความแบบ "Wave 12" / "Wave 12/50" / "12/50" / "12"
local function getWave()
    local obj = gameUI("Stats", "Wave")
    if not obj then return nil end
    local ok, txt = pcall(function()
        if obj:IsA("ValueBase") then return tostring(obj.Value) end
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then return obj.Text end
        for _, d in ipairs(obj:GetDescendants()) do
            if (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) and d.Text:find("%d") then
                return d.Text
            end
        end
    end)
    if not ok or type(txt) ~= "string" then return nil end
