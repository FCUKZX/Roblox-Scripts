local function durText(sec)
    sec = math.max(0, math.floor(sec or 0))
    local h, m, x = sec // 3600, (sec % 3600) // 60, sec % 60
    if h > 0 then return string.format("%d ชั่วโมง %d นาที", h, m) end
    if m > 0 then return string.format("%d นาที %d วินาที", m, x) end
    return string.format("%d วินาที", x)
end

