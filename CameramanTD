-- ========== Log ==========
local logBuf, logDirty = {}, false
local function log(msg)
    msg = tostring(msg)
    logBuf[#logBuf + 1] = os.date("%H:%M:%S") .. "  " .. msg
    if #logBuf > 200 then table.remove(logBuf, 1) end
    logDirty = true
end
local function logf(fmt, ...) log(string.format(fmt, ...)) end

