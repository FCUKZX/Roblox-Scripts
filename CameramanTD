            end
            ui.detectLabel.Text = table.concat({
                "สถานะ: " .. (inGame() and "อยู่ในเกม" or "ลอบบี้ / ยังไม่อยู่ในเกม"),
                "หน้าโหวต/จบเกม: " .. mark(gameUI("GamemodeVoting") or gameUI("FinalUI")),
                "ความเร็วเกม: " .. mark(spd),
                "เงิน: " .. (moneyOK() and fmtNum(getMoney()) or "✗"),
                "ยูนิตของผู้เล่น: " .. mark(slots > 0),
                "แจ้งเตือนของเกม: " .. mark(gameUI("Notifications")),
                "ตรวจยูนิตในฉาก: " .. mark(TD.towersFolder),
                "ระบบสั่งงาน: " .. mark(modeVoteRE and towerAddRE and towerUpgradeRE),
            }, "\n")
        end
        if tAuto.Page.Visible then
            ui.skipLabel.Text = "สถานะ: " .. skipStateText()
            pcall(ui.refreshSpeedList)
        end
        if tLog and tLog.Page.Visible and logDirty then
            logDirty = false
            local from = math.max(1, #logBuf - 17)
            local lines = {}
            for i = from, #logBuf do
                local s = logBuf[i]
                if #s > 110 then s = s:sub(1, 110) .. "…" end
                lines[#lines + 1] = s
            end
            ui.logLabel.Text = #lines > 0 and table.concat(lines, "\n") or "(ยังไม่มี log)"
        end
    end
end)

-- (3) Auto Skip: UIStroke โซนแดง = ปิด -> กดปุ่มให้เปิด
task.spawn(function()
    while alive do
        task.wait(0.25)
        local zone, btn = skipZone()
        if zone and btn and guiVisible(btn) and inGame() then
            local want = CONFIG.AUTO_SKIP and "on" or "red"
            if zone ~= want then
                AS.seen = AS.seen + 1
                if AS.seen >= 2 and os.clock() >= AS.nextAt then
                    AS.fail = AS.fail + 1
                    pcall(pressObj, btn, "AutoSkip", AS.fail)
                    AS.nextAt = os.clock() + (AS.fail >= 6 and 10 or 0.8)
                end
            else
                AS.seen, AS.fail = 0, 0
            end
        else
            AS.seen = 0
        end
    end
end)

