-- ========== Money (leaderstats.Money) ==========
local MONEY = { obj = nil, last = nil, log = {}, head = 1, tail = 0, sig = nil }
local SUFFIX = { K = 1e3, M = 1e6, B = 1e9, T = 1e12 }

local function parseNumber(s)
    if type(s) ~= "string" then return nil end
    local clean = s:gsub(",", ""):gsub("%s", "")
    local num, suf = clean:match("^%$?(%d+%.?%d*)([KkMmBbTt]?)")
    if not num then return nil end
    local n = tonumber(num)
    if not n then return nil end
    if suf ~= "" then n = n * (SUFFIX[suf:upper()] or 1) end
    return n
end

local function readMoneyFrom(obj)
    if not obj then return nil end
    local ok, v = pcall(function()
        if obj:IsA("ValueBase") then return obj.Value end
        return obj.Text
    end)
    if not ok then return nil end
    if type(v) == "number" then return v end
    return parseNumber(tostring(v))
end

local function pushMoney(v)
    if v == nil or v == MONEY.last then return end
    local now = os.clock()
    if MONEY.last ~= nil then
        MONEY.tail = MONEY.tail + 1
        MONEY.log[MONEY.tail] = { t = now, m = v, d = v - MONEY.last }
    end
    MONEY.last = v
    while MONEY.head <= MONEY.tail and now - MONEY.log[MONEY.head].t > 15 do
        MONEY.log[MONEY.head] = nil
        MONEY.head = MONEY.head + 1
    end
end

local function hookMoney(obj)
    if MONEY.sig then MONEY.sig:Disconnect() MONEY.sig = nil end
    MONEY.obj = obj
    MONEY.last = nil
    if not obj then return end
    local prop = obj:IsA("ValueBase") and "Value" or "Text"
    local ok, sig = pcall(function() return obj:GetPropertyChangedSignal(prop) end)
    if ok and sig then
        MONEY.sig = sig:Connect(function() pushMoney(readMoneyFrom(obj)) end)
    end
    MONEY.last = readMoneyFrom(obj)
end

local function findMoneyObj()
    local ls = player:FindFirstChild("leaderstats")
    return ls and ls:FindFirstChild("Money")
end

do
    local lastTry = 0
    track(RunService.Heartbeat:Connect(function()
        if not alive then return end
        if not (MONEY.obj and MONEY.obj.Parent) then
            local now = os.clock()
            if now - lastTry > 2 then
                lastTry = now
                local o = findMoneyObj()
                if o then hookMoney(o) end
            end
            return
        end
        pushMoney(readMoneyFrom(MONEY.obj))
    end))
end

local function moneyOK() return MONEY.obj ~= nil and MONEY.last ~= nil end
local function getMoney() return MONEY.last end

-- เงินลดลงรวม >= minDrop นับตั้งแต่ t0 ไหม
local function spendSince(t0, minDrop)
    local spent = 0
    for i = MONEY.head, MONEY.tail do
        local e = MONEY.log[i]
        if e and e.t >= t0 - 0.02 and e.d < 0 then spent = spent - e.d end
    end
    return spent >= minDrop, spent
end

