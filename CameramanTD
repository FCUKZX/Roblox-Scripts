local function cfgToggle(sec, title, key, extra, desc)
    return sec:Toggle({
        Title = title, Desc = desc, Default = CONFIG[key],
        Callback = function(v)
            CONFIG[key] = v
            saveSettings()
            if extra then extra(v) end
        end,
    })
end

