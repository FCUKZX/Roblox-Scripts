-- ---- แหล่งสำรอง : GUID จาก event ----
local ID_KEYS = { "Id", "ID", "id", "TowerId", "TowerID", "Guid", "GUID", "UID", "Uid" }

local function collectIds(v, out, seen, depth, budget)
    if depth > 3 or budget.n <= 0 then return end
    if type(v) == "string" then
        if isGuid(v) and not seen[v] then
            local c = { id = v, bare = true }
            seen[v] = c
            out[#out + 1] = c
        end
        return
    end
    if type(v) ~= "table" then return end
    budget.n = budget.n - 1
    for _, k in ipairs(ID_KEYS) do
        local x = v[k]
        if isGuid(x) then
            local pos = v.Pos or v.Position
            if typeof(pos) ~= "Vector3" then
                pos = (typeof(v.CFrame) == "CFrame") and v.CFrame.Position or nil
            end
            local c = seen[x]
            if not c then
                c = { id = x }
                seen[x] = c
                out[#out + 1] = c
            end
            c.bare = nil
            c.name = c.name or v.Name or v.UnitName or v.TowerName
            c.pos = c.pos or pos
            break
        end
    end
    for k, x in pairs(v) do
        budget.n = budget.n - 1
        if k ~= "UnitId" and k ~= "UnitID" then
            collectIds(x, out, seen, depth + 1, budget)
        end
    end
end

local function onRemoteEvent(rem, ...)
    local name = rem.Name
    local args = table.pack(...)
    local now = os.clock()

    if name == "TowerUpgrade" then
        local p = args[1]
        if type(p) == "table" and p.Id ~= nil then
            local st = type(p.Stats) == "table" and p.Stats or nil
            TD.upg[tostring(p.Id)] = {
                t = now,
                level = tonumber(p.Level),
                price = st and tonumber(st.Price) or nil,
            }
        end
    end

    if name == "TowerUpgrade" then
        local p = args[1]
        if type(p) == "table" and p.Id ~= nil then
            local st = type(p.Stats) == "table" and p.Stats or nil
            TD.upgEvents[#TD.upgEvents + 1] = {
                t = now, id = tostring(p.Id), level = tonumber(p.Level),
                price = st and tonumber(st.Price) or nil,
            }
            dbg("เก็บ event อัปเกรด Id=%s price=%s", tostring(p.Id), tostring(st and st.Price))
            while #TD.upgEvents > 60 do table.remove(TD.upgEvents, 1) end
            if TD.resolvePrices then TD.resolvePrices() end
        end
    elseif name == "TowerAdd" then
        local p = args[1]
        dbg("event TowerAdd: arg1=%s Id=%s UnitId=%s Stats=%s", type(p),
            type(p) == "table" and tostring(p.Id) or "-", type(p) == "table" and tostring(p.UnitId) or "-",
            type(p) == "table" and type(p.Stats) or "-")
        if type(p) == "table" and p.Id ~= nil then
            local st = type(p.Stats) == "table" and p.Stats or nil
            local price = st and tonumber(st.Price) or nil
            if price then
                TD.addSeen = (TD.addSeen or 0) + 1
                TD.adds[#TD.adds + 1] = { t = now, id = tostring(p.Id), unitId = p.UnitId, price = price }
                while #TD.adds > 60 do table.remove(TD.adds, 1) end
                dbg("เก็บ event วาง price=%s (adds=%d)", tostring(price), #TD.adds)
                if TD.resolvePrices then TD.resolvePrices() end
            end
        end
    end

    if CONFIG.SNIFFER and now < TD.sniffUntil then
        local r = TD.rate[name]
        if not r or now - r.t0 >= 1 then
            r = { t0 = now, n = 0 }
            TD.rate[name] = r
        end
        r.n = r.n + 1
        if r.n <= 3 then log("◀ " .. name .. "  " .. shortArgs(args)) end
    end

    if name ~= "TowerUpgrade" and now < TD.scanUntil then
        local out, seen, budget = {}, {}, { n = 80 }
        for i = 1, args.n do collectIds(args[i], out, seen, 0, budget) end
        for _, c in ipairs(out) do
            c.t = now
            c.src = "event"
            c.from = name
            addCand(c)
        end
    end
end

local function tapRemote(rem)
    if TD.tapped[rem] then return end
    if not rem:IsA("RemoteEvent") then return end
    TD.tapped[rem] = true
    track(rem.OnClientEvent:Connect(function(...)
        if not alive then return end
        local ok, err = pcall(onRemoteEvent, rem, ...)
        if not ok then logf("onRemoteEvent error: %s", tostring(err)) end
    end))
end

if netFolder then
    for _, c in ipairs(netFolder:GetChildren()) do tapRemote(c) end
    track(netFolder.ChildAdded:Connect(tapRemote))
end

-- ---- จับคู่ผู้สมัครกับยูนิตที่วาง ----
local function nameMatch(a, b)
    a, b = string.lower(tostring(a)), string.lower(tostring(b))
    return a == b or string.find(a, b, 1, true) ~= nil or string.find(b, a, 1, true) ~= nil
end

local function scoreCand(c, a)
    local s
    if c.src == "towers" then s = 4 elseif c.bare then s = 0.5 else s = 1 end

    local cpos = c.pos or (c.inst and instPos(c.inst))
    if typeof(cpos) == "Vector3" and typeof(a.pos) == "Vector3" then
        local d = Vector3.new(cpos.X - a.pos.X, 0, cpos.Z - a.pos.Z).Magnitude
        if d <= 5 then s = s + 5 + (5 - d) * 0.1 elseif d > 25 then return nil end
    end
    if c.name and a.name then
        if nameMatch(c.name, a.name) then s = s + 2 else return nil end
    end
    return s
end

-- หาผู้สมัครที่ดีที่สุดที่โผล่หลังเวลา since (ไม่รอ)
function TD.pick(action, since)
    local best, bestScore
    for _, c in ipairs(TD.cands) do
        if c.t >= since and not TD.used[c.id] and c.id ~= action.unitId
            and not (c.inst and not c.inst.Parent) then
            local sc = scoreCand(c, action)
            if sc and (not bestScore or sc > bestScore) then best, bestScore = c, sc end
        end
    end
    return best
end

-- รอจนเจอ Id (หรือหมดเวลา)  คืน id หรือ nil
function TD.claim(action, since, timeout, active)
    local deadline = os.clock() + timeout
    repeat
        local c = TD.pick(action, since)
        if c then
            TD.used[c.id] = true
            return c.id, c.src
        end
        task.wait(0.05)
    until os.clock() > deadline or (active and not active())
    return nil
end

-- =====================================================================
--  บันทึกมาโคร (ดัก FireServer ของ ModeVote / TowerAdd / TowerUpgrade)
-- =====================================================================
local lastVote = nil   -- { args = {...}, t = เวลา }  โหวตล่าสุดที่ผู้เล่นกดเอง
local rec = { times = {}, priceWait = {}, ticketIssued = 0, ticketServing = 0, pending = 0, measures = 0, seq = 0 }

local function refreshAll()
    if ui.refreshAll then pcall(ui.refreshAll) end
end

local function nextAfter(tc)
    local best
    for _, t in ipairs(rec.times) do
        if t > tc and (not best or t < best) then best = t end
    end
    return best
end

-- เงินที่ลดลงในช่วง [t0, t1]  (ทำเครื่องหมายว่าใช้แล้ว กันนับซ้ำกับแอคชันถัดไป)
local function measureCost(t0, t1)
    local tot = 0
    for i = MONEY.head, MONEY.tail do
        local e = MONEY.log[i]
        if e and not e.claimed and e.t >= t0 - 0.1 and e.t <= t1 and e.d < 0 then
            tot = tot - e.d
            e.claimed = true
        end
    end
    return tot
end

-- ผูกราคาจาก event ของเกม (Stats.Price) เข้ากับแถวที่บันทึกไว้ทันทีที่ event มาถึง
--   วาง   : จับคู่ด้วย UnitId (event ส่ง UnitId เดิมกลับมา) ตัวเก่าสุดก่อน แล้วใช้ Id จาก event เป็น Id ของยูนิต
--   อัปเกรด: จับคู่ด้วย Id เดียวกับที่ยิงตอนอัปเกรด
function TD.resolvePrices()
    local list = rec.priceWait
    local now = os.clock()
    local i = 1
    while i <= #list do
        local w = list[i]
        local a, e = w.action, nil
        if a.type == "Place" then
            for _, x in ipairs(TD.adds) do
                if not x.claimed and x.t >= w.tc - 2 and (x.unitId == nil or a.unitId == nil or x.unitId == a.unitId) then
                    e = x
                    break
                end
            end
        else
            for _, x in ipairs(TD.upgEvents) do
                if not x.claimed and x.id == a.tid and x.t >= w.tc - 2 then
                    e = x
                    break
                end
            end
        end
        if e and e.price and e.price > 0 then
            e.claimed = true
            a.cost = e.price
            a.costExact = true
            if a.type == "Place" then a.tid = e.id else a.level = e.level end
            table.remove(list, i)
            local idx
            for k, x in ipairs(recordedActions) do if x == a then idx = k break end end
            dbg("ได้ราคา #%s %s = %s", tostring(idx or "?"),
                a.type == "Place" and ("วาง " .. tostring(a.name)) or "อัปเกรด", fmtNum(e.price))
            refreshAll()
        elseif now - w.tc > 30 then
            table.remove(list, i)
        else
            if not w.logged then
                w.logged = true
                dbg("ยังไม่เจอราคาให้ %s unit=%s tid=%s (adds=%d upg=%d)", a.type, tostring(a.unitId),
                    tostring(a.tid), #TD.adds, #TD.upgEvents)
            end
            i = i + 1
        end
    end
end

local function scheduleMeasure(action, tc)
    rec.measures = rec.measures + 1
    rec.priceWait[#rec.priceWait + 1] = { action = action, tc = tc }
    dbg("รอราคา %s unit=%s tid=%s (adds=%d upg=%d)", action.type, tostring(action.unitId),
        tostring(action.tid), #TD.adds, #TD.upgEvents)
    local okR, errR = pcall(TD.resolvePrices)   -- เผื่อ event มาถึงก่อนแล้ว
    if not okR then dbg("resolvePrices error: %s", tostring(errR)) end
    task.spawn(function()
        local ok, err = pcall(function()
            local win = math.max(1.0, getPing() * 2 + 0.7)
            task.wait(win)
            local t1 = tc + win
            local nxt = nextAfter(tc)
            if nxt and nxt < t1 then t1 = nxt end

            local cost = 0
            if moneyOK() then cost = measureCost(tc, t1) end

            -- ได้ราคาจาก event แล้ว = ไม่แตะ / ยังไม่ได้ = ใช้ราคาสำรองจากเงินที่ลดลง (event มาทีหลังจะทับให้เอง)
            if not action.costExact then
                if action.type == "Upgrade" then
                    local u = TD.upg[action.tid]
                    if u and u.t >= tc - 0.1 then
                        action.level = u.level
                        if cost <= 0 and u.price then cost = u.price end
                    end
                end
                action.cost = cost
                local wait2 = os.clock() + 2
                while not action.costExact and os.clock() < wait2 do task.wait(0.1) end
                if not action.costExact then
                    local what = action.type == "Place" and "วาง" or "อัปเกรด"
                    local seen = action.type == "Place" and (TD.addSeen or 0) or #TD.upgEvents
                    dbg("จับราคา%s ไม่ได้ (event ที่เคยได้รับ %d ตัว)", what, seen)
                end
            end
        end)
        if not ok then
            dbg("วัดราคา error: %s", tostring(err))
        end
        dbg("จบวัด %s cost=%s exact=%s", action.type, tostring(action.cost), tostring(action.costExact))
        rec.measures = rec.measures - 1
        refreshAll()
    end)
end

-- หา Id ของยูนิตที่เพิ่งวาง (เรียงคิว กันสองตัวแย่งกัน)
local function registerPlaced(action, tc)
    rec.pending = rec.pending + 1
    rec.ticketIssued = rec.ticketIssued + 1
    local my = rec.ticketIssued
    task.spawn(function()
        while rec.ticketServing + 1 ~= my and alive do task.wait(0.05) end
        local id, src = TD.claim(action, tc - 0.3, CONFIG.ID_WAIT + 1, function() return alive end)
        if id then
            action.tid = action.tid or id
            logf("ยูนิต %s -> Id %s (จาก %s)", tostring(action.name), tostring(id), tostring(src))
        else
            logf("⚠️ จับ Id ของ %s ไม่ได้ (ดู Log / Settings > Detection)", tostring(action.name))
        end
        rec.ticketServing = my
        rec.pending = rec.pending - 1
        refreshAll()
    end)
end

function TD.waveField(w)
    if type(w) == "number" and w > 0 then return w end
    return nil
end

-- seq = ลำดับที่จองไว้ตอนดัก FireServer (ก่อน defer) / wave = เวฟตอนนั้น
local function recordPlace(p, tc, seq, wave)
    if type(p) ~= "table" then return end
    local cf = typeof(p.CFrame) == "CFrame" and p.CFrame or nil
    local pos = typeof(p.Pos) == "Vector3" and p.Pos or (cf and cf.Position) or nil
    local action = {
        type = "Place", name = p.Name, unitId = p.UnitId,
        cframe = cf, pos = pos, cost = 0, seq = seq,
    }
    recordedActions[#recordedActions + 1] = action
    rec.times[#rec.times + 1] = tc
    macroDirty = true
    registerPlaced(action, tc)
    scheduleMeasure(action, tc)
    refreshAll()
end

local function recordUpgrade(p, tc, seq, wave)
    if type(p) ~= "table" or p.Id == nil then return end
    local action = { type = "Upgrade", tid = tostring(p.Id), cost = 0, seq = seq }
    recordedActions[#recordedActions + 1] = action
    rec.times[#rec.times + 1] = tc
    macroDirty = true
    scheduleMeasure(action, tc)
    refreshAll()
end

-- ขายยูนิต: Id เดียวกับตอนวาง/อัปเกรด  (ไม่วัดราคา -- ขายแล้วเงินเข้า ไม่ใช่เงินออก)
local function recordSell(p, tc, seq, wave)
    if type(p) ~= "table" or p.Id == nil then return end
    local action = { type = "Sell", tid = tostring(p.Id), cost = 0, costExact = true, seq = seq }
    recordedActions[#recordedActions + 1] = action
    rec.times[#rec.times + 1] = tc   -- ให้หน้าต่างวัดราคาของแอคชันก่อนหน้าหยุดที่จุดนี้
    macroDirty = true
    refreshAll()
end

-- แอคชันที่อ้างอิงยูนิตผ่าน unitRef (อัปเกรด / ขาย)
function TD.isRef(a)
    return a ~= nil and (a.type == "Upgrade" or a.type == "Sell")
end

-- เรียงแอคชันตามลำดับเหตุการณ์จริง (seq จองตอนดัก FireServer)  คืน true ถ้ามีการสลับที่
function TD.sortBySeq(actions)
    local changed = false
    for i = 2, #actions do
        if (actions[i].seq or 0) < (actions[i - 1].seq or 0) then changed = true break end
    end
    if changed then
        table.sort(actions, function(x, y) return (x.seq or 0) < (y.seq or 0) end)
    end
    return changed
end

-- จับคู่ Upgrade/Sell -> Place ผ่าน tid (ถ้า Place ไหนไม่มี tid ให้เดาจากลำดับ)
-- ต้องเรียกหลังเรียง seq แล้ว เพราะ unitRef = เลขแถวของ Place
local function linkUnits(actions)
    local idToIndex = {}
    for i, a in ipairs(actions) do
        if a.type == "Place" and a.tid then idToIndex[a.tid] = i end
    end
    local unresolved, guessed = 0, 0
    for i, a in ipairs(actions) do
        if TD.isRef(a) then
            if not idToIndex[a.tid] then
                for j = 1, i - 1 do
                    local p = actions[j]
                    if p.type == "Place" and not p.tid then
                        p.tid = a.tid
                        idToIndex[a.tid] = j
                        guessed = guessed + 1
                        break
                    end
                end
            end
            a.unitRef = idToIndex[a.tid]
            if not a.unitRef then unresolved = unresolved + 1 end
        end
    end
    return unresolved, guessed
end

-- ---------- hook FireServer ----------
local function onOutgoing(rem, args, seq, tc, wave)
    if not alive then return end
    local now = os.clock()
    tc = tc or now
    TD.scanUntil = now + 8
    TD.sniffUntil = now + 6
    if CONFIG.SNIFFER then log("▶ " .. rem.Name .. "  " .. shortArgs(args)) end
    dbg("ดัก %s | กำลังบันทึก=%s กำลังเล่น=%s", rem.Name, tostring(isRecording), tostring(isPlaying))

    if rem == modeVoteRE then
        lastVote = { args = { table.unpack(args, 1, args.n) }, t = now }
        if isRecording and not isPlaying then
            macroMeta.vote = lastVote.args
            macroDirty = true
            refreshAll()
        end
    elseif isRecording and not isPlaying then
        local fn
        if rem == towerAddRE then fn = recordPlace
        elseif rem == towerUpgradeRE then fn = recordUpgrade
        elseif rem == towerSellRE then fn = recordSell end
        dbg("เรียกบันทึก %s ได้=%s arg1=%s", rem.Name, tostring(fn ~= nil), type(args[1]))
        if fn then
            local okF, errF = pcall(fn, args[1], tc, seq, wave)
            if not okF then dbg("บันทึก %s error: %s", rem.Name, tostring(errF)) end
        end
    end
end

