-- ========== ตัวช่วยแปลงค่าเป็นข้อความสั้น (ใช้ใน Log) ==========
local function short(v, depth)
    depth = depth or 0
    local t = typeof(v)
    if t == "string" then
        return '"' .. (#v > 40 and (v:sub(1, 40) .. "…") or v) .. '"'
    elseif t == "number" then
        return string.format("%.4g", v)
    elseif t == "boolean" or t == "nil" then
        return tostring(v)
    elseif t == "Vector3" then
        return string.format("V3(%.1f,%.1f,%.1f)", v.X, v.Y, v.Z)
    elseif t == "CFrame" then
        local p = v.Position
        return string.format("CF(%.1f,%.1f,%.1f)", p.X, p.Y, p.Z)
    elseif t == "Instance" then
        return "<" .. v.Name .. ">"
    elseif t == "table" then
        if depth >= 3 then return "{…}" end
        local parts, n = {}, 0
        for k, x in pairs(v) do
            n = n + 1
            if n > 8 then parts[#parts + 1] = "…" break end
            parts[#parts + 1] = (type(k) == "number" and "" or (tostring(k) .. "=")) .. short(x, depth + 1)
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return "<" .. t .. ">"
end

local function shortArgs(args)
    local out = {}
    for i = 1, args.n do out[i] = short(args[i], 0) end
    local s = table.concat(out, " | ")
    if #s > 220 then s = s:sub(1, 220) .. "…" end
    return s
end

-- =====================================================================
--  หา Id ของยูนิตที่เพิ่งวาง
--  แหล่งหลัก: workspace.Game.Towers  -> ตัวที่เด้งเข้ามาหลังวางคือยูนิตนั้น  ชื่อ (Name) = Id ที่ใช้อัปเกรด
--  แหล่งสำรอง: GUID ที่เซิร์ฟเวอร์ส่งมากับ RemoteEvent (OnClientEvent) ช่วงหลังวาง
-- =====================================================================
local TD = {
    cands = {},        -- { id, t, src, inst?, name?, pos?, bare? }
    used = {},         -- Id ที่จับคู่แล้วในรอบนี้
    upg = {},          -- [Id] = { t, level, price }  จาก TowerUpgrade.OnClientEvent
    adds = {},         -- รายการ TowerAdd.OnClientEvent { t, id, name, pos, price }  (ราคาวาง)
    upgEvents = {},    -- รายการ TowerUpgrade.OnClientEvent { t, id, level, price }  (ราคาอัปเกรด)
    scanUntil = 0,     -- ก่อนเวลานี้ ถึงจะสแกน event หา GUID
    sniffUntil = 0,    -- ก่อนเวลานี้ ถึงจะจด event ลง Log
