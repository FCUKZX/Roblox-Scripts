-- (3) Auto Skip: UIStroke โซนแดง = ปิด -> กดปุ่มให้เปิด
task.spawn(function()
    while alive do
        task.wait(0.25)
        local zone, btn = skipZone()
        if zone and btn and guiVisible(btn) and inGame() then
            local want = (CONFIG.AUTO_SKIP and not AS.blocked()) and "on" or "red"
            if zone ~= want then
                AS.seen = AS.seen + 1
                if AS.seen >= 2 and os.clock() >= AS.nextAt then
                    AS.fail = AS.fail + 1
                    pcall(pressObj, btn, "AutoSkip", AS.fail)
                    AS.nextAt = os.clock() + (AS.fail >= 6 and 10 or 0.8)
                end
            else
                AS.seen, AS.fail = 0, 0
            end
        else
            AS.seen = 0
        end
    end
end)

