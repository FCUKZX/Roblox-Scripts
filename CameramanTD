-- ---------- เริ่ม / จบการบันทึก ----------
local function startRecording()
    if isPlaying then
        setStatus("กำลังเล่นมาโครอยู่ หยุดก่อนจึงจะบันทึกได้", "warn", "square")
        return false
    end
    if isRecording then return false end
    if not (towerAddRE and towerUpgradeRE) then
        setStatus("ระบบยังไม่พร้อม ลองเข้าเกมใหม่อีกครั้ง", "bad", "x")
        return false
    end
    if not (hookmetamethod and getnamecallmethod) then
        setStatus("executor นี้ไม่รองรับการบันทึก", "bad", "x")
        return false
    end
    if not inGame() then
        setStatus("ตอนนี้อยู่ลอบบี้ บันทึกได้เฉพาะตอนอยู่ในเกม", "warn", "flag")
        return false
    end
    if CONFIG.REQUIRE_VOTE_UI and not votingOpen() then
        setStatus("เริ่มบันทึกได้เฉพาะตอนหน้าโหวตโหมดเปิดอยู่ รอเกมใหม่แล้วกดอีกครั้ง", "warn", "flag")
        return false
    end

    recordedActions = {}
    macroMeta = { vote = nil }
    rec.times = {}
    rec.priceWait = {}
    rec.ticketIssued, rec.ticketServing, rec.pending, rec.measures = 0, 0, 0, 0
    TD.used = {}
    selectedName = nil
    macroDirty = true
    -- ผู้เล่นโหวตไปก่อนกดบันทึก (หน้าโหวตยังเปิดอยู่) ก็เก็บโหวตนั้นไว้
    if lastVote and os.clock() - lastVote.t < 60 and votingOpen() then
        macroMeta.vote = lastVote.args
    end
    isRecording = true
    setStatus("เริ่มบันทึกแล้ว", "ok", "circle-dot")
    refreshAll()
    return true
end

local function finishRecording(reason)
    dbg("finishRecording: %s (บันทึกอยู่=%s)", tostring(reason), tostring(isRecording))
    if not isRecording then return end
    isRecording = false
    refreshAll()
    setQuiet("กำลังสรุปการบันทึก...")
    task.spawn(function()
        local t = os.clock()
        while (rec.pending > 0 or rec.measures > 0) and os.clock() - t < 8 and alive do
            task.wait(0.1)
        end
        local reordered = TD.sortBySeq(recordedActions)
        local unresolved, guessed = linkUnits(recordedActions)
        macroDirty = true

        if #recordedActions == 0 then
            setStatus("ไม่ได้บันทึกอะไรเลย", "warn", "x")
            refreshAll()
            return
        end

        local base = cleanName(ui.nameBox and ui.nameBox.Text or "")
        if base == "" then base = "Macro_" .. os.date("%H%M%S") end
        local name = uniqueName(base)
        local ok, err = saveMacro(name, recordedActions, macroMeta)
        if ok then
            selectedName = name
            macroDirty = false
        end

        -- แถวที่ยังไม่มีราคา (เดิมเด้งเตือนทีละแถว -> รวมเป็นบรรทัดเดียวตอนจบ)
        local noPrice = 0
        for _, a in ipairs(recordedActions) do
            if a.type ~= "Sell" and (a.cost or 0) <= 0 and not a.costExact then noPrice = noPrice + 1 end
        end
        if not ok then logf("เซฟไม่สำเร็จ: %s", tostring(err)) end
        if reordered or guessed > 0 then logf("จัดลำดับใหม่=%s เดา Id=%d", tostring(reordered), guessed) end

        local head = (reason and reason ~= "หยุดบันทึก") and (reason .. " | ") or ""
        local msg = head .. string.format("จบการบันทึก %d แอคชัน | โหวตโหมด: %s", #recordedActions,
            macroMeta.vote and TD.voteText(macroMeta.vote) or "ไม่มี")
        if ok then msg = msg .. " | เซฟเป็น " .. name else msg = msg .. " | เซฟไม่สำเร็จ" end
        if unresolved > 0 then msg = msg .. string.format(" | %d แถวผูกกับยูนิตไม่ได้ (เช็กที่แท็บ Editor)", unresolved) end
        if noPrice > 0 then msg = msg .. string.format(" | %d แถวยังไม่มีราคา (แก้ที่แท็บ Editor)", noPrice) end
        setStatus(msg, (unresolved > 0 or noPrice > 0 or not ok) and "warn" or "ok", "save")
        refreshAll()
    end)
end

-- =====================================================================
--  เล่นมาโครซ้ำ
-- =====================================================================
local function costInfo(action)
    local base = action.cost or 0
    local cost = base > 0 and (base + CONFIG.COST_MARGIN) or 0
    local free = base <= 0 and action.costExact == true
    local unknown = base <= 0 and not free
    return cost, free, unknown
end

-- รอจนเงินพอ  คืน "ready" | "probe" (ใกล้พอ ลองยิง) | "timeout" | "aborted" | "gameover"
local function waitUntilAffordable(spec, lastFireT)
    if spec.unknown or spec.cost <= 0 or not moneyOK() then return "ready" end
    spec.waitSince = spec.waitSince or os.clock()
    local eager = CONFIG.EAGER_PERCENT / 100
    local lastNotice = 0
    while true do
        if not spec.active() then return "aborted" end
        if isGameOver() then return "gameover" end
        local m = getMoney()
        if m == nil or m >= spec.cost then return "ready" end
        local now = os.clock()
        if CONFIG.EAGER_ON and m >= spec.cost * eager and now - lastFireT >= CONFIG.PROBE_INTERVAL then
            return "probe"
        end
        if now - spec.waitSince > CONFIG.MONEY_TIMEOUT then return "timeout" end
        if now - lastNotice > 1 then
            lastNotice = now
            setQuiet(string.format("%s | รอเงิน %s/%s", spec.label, fmtNum(m), fmtNum(spec.cost)))
        end
        task.wait(0.05)
    end
end

-- spec = { label, cost, unknown, maxAttempts, untilPlaced, statKey, active, attempt = function(t0) -> ok, extra }
--   untilPlaced = true -> วนจนวางติด (หยุดเมื่อกดหยุด / จบเกม / ออกจากเกม / พลาดครบ maxAttempts ถ้าตั้งไว้)
-- คืน "ok", extra | "failed" | "aborted" | "gameover"
local function runWithRetry(spec)
    local startT, attempts, lastFireT = os.clock(), 0, -math.huge
    while true do
        if spec.untilPlaced then
            if isGameOver() or not inGame() then return "gameover" end
            if spec.maxAttempts and attempts >= spec.maxAttempts then break end   -- [แพตช์] พลาดครบจำนวน = ข้ามยูนิตนี้
        elseif spec.unknown then
            if attempts > 0 and os.clock() - startT > CONFIG.UNKNOWN_COST_WAIT then break end
        elseif attempts >= spec.maxAttempts then
            break
        end

        local w = waitUntilAffordable(spec, lastFireT)
        if w == "aborted" or w == "gameover" then return w end
        local probing = (w == "probe")
        if w == "timeout" then
            logf("%s: รอเงินเกิน %d วิ ลองยิงเลย", spec.label, CONFIG.MONEY_TIMEOUT)
        end
        if not probing then attempts = attempts + 1 end

        local t0 = os.clock()
        lastFireT = t0
        local okCall, success, extra = pcall(spec.attempt, t0, attempts, probing)
        if not okCall then
            logf("%s: error %s", spec.label, tostring(success))
            success, extra = false, nil
        end
        if not spec.active() then return "aborted" end

        if success then
            stats[spec.statKey] = stats[spec.statKey] + 1
            return "ok", extra
        end
        if not probing then
            stats.retries = stats.retries + 1
            task.wait(CONFIG.RETRY_DELAY)
        end
    end
    stats.failures = stats.failures + 1
    logf("%s: ไม่สำเร็จ", spec.label)
    return "failed"
end

-- วางแล้วสำเร็จไหม: เจอ Id ใหม่ใน workspace.Game.Towers (หรือ event) หรือเงินลดลง
local function awaitPlaced(action, since, active, minDrop, t0)
    local deadline = t0 + math.max(2.2, getPing() * 3 + 1.4)   -- [แพตช์] รอนานขึ้น กันแล็กจนนับว่าวางไม่ติด
    while os.clock() < deadline and active() do
        local c = TD.pick(action, since - 0.3)
        if c then
            TD.used[c.id] = true
            return true, c.id
        end
        if moneyOK() and spendSince(since, minDrop) then
            -- เงินลดแล้ว = วางสำเร็จ แต่ขอรอ Id อีกนิด (ต้องใช้ตอนอัปเกรด)
            local d2 = os.clock() + CONFIG.ID_WAIT
            while os.clock() < d2 and active() do
                local c2 = TD.pick(action, since - 0.3)
                if c2 then
                    TD.used[c2.id] = true
                    return true, c2.id
                end
                task.wait(0.05)
            end
            return true, nil
        end
        task.wait(0.05)
    end
    return false
end

-- =====================================================================
--  UnitId จาก Attributes ของผู้เล่น (Players.<ชื่อเรา>:GetAttributes())
--    Slot1 = "Camera Helicopter"   Slot1Id = "2dfed4cf-7359-..."
--  UnitId เปลี่ยนได้ทุกครั้งที่เข้าเกม -> ก่อนวางให้หาช่องที่ "ชื่อตรงกับที่บันทึกไว้" แล้วใช้ Id ของช่องนั้น
-- =====================================================================
local function normName(v)
    return (tostring(v):gsub("^%s+", ""):gsub("%s+$", "")):lower()
end

local function hasSlotAttrs()
    for k in pairs(player:GetAttributes()) do
        if type(k) == "string" and k:match("^Slot%d+$") then return true end
    end
    return false
end

-- คืน id, เลขช่อง  (ชื่อซ้ำหลายช่อง = เอาช่องเลขน้อยสุด)  ไม่เจอ = nil
local function slotUnitId(name)
    if name == nil then return nil end
    local attrs = player:GetAttributes()
    local want = normName(name)
    local bestId, bestSlot
    for k, v in pairs(attrs) do
        local n = type(k) == "string" and k:match("^Slot(%d+)$")
        if n and type(v) == "string" and normName(v) == want then
            local id = attrs["Slot" .. n .. "Id"]
            local num = tonumber(n)
            if type(id) == "string" and id ~= "" and (not bestSlot or num < bestSlot) then
                bestId, bestSlot = id, num
            end
        end
    end
    return bestId, bestSlot
end

-- รอ Attributes ขึ้น (สูงสุด 3 วิ) แล้วหา Id ของยูนิตชื่อนี้  ไม่เจอ = nil
local function resolveUnitId(name, active)
    local deadline = os.clock() + 3
    repeat
        local id, slot = slotUnitId(name)
        if id then return id, slot end
        if hasSlotAttrs() then break end   -- Slot มีแล้วแต่ไม่มีชื่อนี้ ไม่ต้องรอ
        task.wait(0.1)
    until os.clock() > deadline or (active and not active())
    return nil
end

-- สุ่มเลื่อนตำแหน่ง X/Z ตอนวาง (ไม่แก้ค่าที่บันทึกไว้ ทุกรอบสุ่มใหม่)
--   scale 1 = เต็มระยะตามที่ตั้ง | 0.5 = ครึ่งหนึ่ง | 0 = ตรงเป๊ะ
function PLACE.offset(scale)
    local acc = math.clamp(tonumber(CONFIG.PLACE_ACCURACY) or DEFAULTS.PLACE_ACCURACY, PLACE.MIN, 100)
    local maxR = (100 - acc) / 100 * PLACE.STUDS * (scale or 1)
    if maxR <= 0 then return 0, 0 end
    local r = maxR * (0.4 + 0.6 * PLACE.rng:NextNumber())   -- เลื่อนอย่างน้อย 40% ของระยะสูงสุด ไม่เกินระยะสูงสุด
    local th = PLACE.rng:NextNumber() * math.pi * 2
    return math.cos(th) * r, math.sin(th) * r
end

-- ขยับออกหลังวางไม่ติด: สุ่มจุดใหม่รอบจุดที่บันทึกไว้ (ระยะ ESC_MIN ถึงระยะที่ขยายตามจำนวนจุดที่ล้มเหลว)
--   failed = รายการ { dx, dz } ของจุดที่วางไม่ติด (เทียบกับจุดที่บันทึกไว้)
--   ห้ามอยู่ในวงรัศมี SAME รอบจุดที่เคยวางไม่ติด  คืน dx, dz
--   (เก็บไว้เป็นตัวสำรอง ตัวหลักตอนนี้คือ PLACE.choose ด้านล่าง)
function PLACE.escape(failed)
    local reach = math.clamp(PLACE.ESC_MIN + PLACE.ESC_GROW * #failed, PLACE.ESC_MIN, PLACE.ESC_MAX)
    local bestX, bestZ, bestGap = 0, 0, -1
    for _ = 1, 60 do
        local r = PLACE.ESC_MIN + (reach - PLACE.ESC_MIN) * PLACE.rng:NextNumber()
        local th = PLACE.rng:NextNumber() * math.pi * 2
        local x, z = math.cos(th) * r, math.sin(th) * r
        local gap = math.huge
        for _, f in ipairs(failed) do
            gap = math.min(gap, math.sqrt((x - f[1]) ^ 2 + (z - f[2]) ^ 2))
        end
        if gap >= PLACE.SAME then return x, z end
        if gap > bestGap then bestX, bestZ, bestGap = x, z, gap end
    end
    -- สุ่มไม่เจอช่องว่างเลย (จุดที่ล้มเหลวเยอะมาก) ใช้จุดที่ห่างจากจุดที่เคยพลาดมากที่สุดที่สุ่มได้
    return bestX, bestZ
end

-- =====================================================================
--  [แพตช์] เลือกจุดวางแบบหลบยูนิตอื่น (ใช้ตารางสนาม PLACE ไม่เพิ่ม local ระดับบนสุด)
-- =====================================================================
PLACE.CLEAR   = 3.5   -- ห่างจากยูนิตที่มีอยู่แล้วอย่างน้อยกี่สตั๊ด (ถ้ายูนิตใหญ่/ชนบ่อย เพิ่มเลขนี้)
PLACE.MAX_TRY = 40    -- วางไม่ติดครบกี่ครั้งแล้วข้ามยูนิตนี้ (กันค้างตลอดกาล)  ใส่ nil = ไม่จำกัด
PLACE.BAD_MAX = 150   -- จำจุดที่วางไม่ติดไว้สูงสุดกี่จุด
PLACE.BAD_TTL = 900   -- จำจุดที่วางไม่ติดไว้กี่วินาที (กันจำผิดเพราะแล็ก)
PLACE.bad = {}        -- { {p = Vector3, t = เวลา} }  จุดจริงในโลกที่เคยวางไม่ติด (ข้ามรอบได้)

function PLACE.flat(a, b)
    local dx, dz = a.X - b.X, a.Z - b.Z
    return math.sqrt(dx * dx + dz * dz)
end

-- ตำแหน่งยูนิตทั้งหมดที่อยู่ในฉากตอนนี้ (workspace.Game.Towers)
function PLACE.occupied()
    local list = {}
    local f = TD.towersFolder
    if f and f.Parent then
        for _, t in ipairs(f:GetChildren()) do
            local p = instPos(t)
            if p then list[#list + 1] = p end
        end
    end
    return list
end

function PLACE.markBad(p)
    if typeof(p) ~= "Vector3" then return end
    local now = os.clock()
    for i = #PLACE.bad, 1, -1 do
        if now - PLACE.bad[i].t > PLACE.BAD_TTL then table.remove(PLACE.bad, i) end
    end
    PLACE.bad[#PLACE.bad + 1] = { p = p, t = now }
    while #PLACE.bad > PLACE.BAD_MAX do table.remove(PLACE.bad, 1) end
end

function PLACE.nearBad(p)
    local now = os.clock()
    for _, b in ipairs(PLACE.bad) do
        if now - b.t <= PLACE.BAD_TTL and PLACE.flat(p, b.p) < PLACE.SAME then return true end
    end
    return false
end

-- เลือกจุดสำรองหลังส่งตำแหน่งเดิมแล้ววางไม่ติด: คืน dx, dz เทียบกับ base
-- ต้องห่างจากยูนิตอื่นอย่างน้อย CLEAR และไม่ย้อนกลับไปจุดที่เคยวางไม่ติด
-- tried = รายการ { dx, dz } ที่ยิงแล้ววางไม่ติดในแอคชันนี้
function PLACE.choose(base, tried)
    tried = tried or {}
    local occ = PLACE.occupied()

    local function score(dx, dz)
        local p = Vector3.new(base.X + dx, base.Y, base.Z + dz)

        if PLACE.nearBad(p) then
            return -1
        end

        for _, f in ipairs(tried) do
            local tx, tz = tonumber(f[1]) or 0, tonumber(f[2]) or 0
            local ddx, ddz = dx - tx, dz - tz
            if math.sqrt(ddx * ddx + ddz * ddz) < PLACE.SAME then
                return -1
            end
        end

        local best = math.huge
        for _, occupiedPos in ipairs(occ) do
            local distance = PLACE.flat(p, occupiedPos)
            if distance < best then
                best = distance
            end
        end

        -- คืนระยะห่างจากยูนิตที่ใกล้ที่สุด (ถ้าไม่มียูนิตจะเป็น math.huge)
        return best
    end

    -- ลองขยับเล็กน้อยก่อน
    if #tried == 0 then
        for _ = 1, 25 do
            local dx, dz = PLACE.offset(1)
            if score(dx, dz) >= PLACE.CLEAR then
                return dx, dz
            end
        end
    end

    -- ขยายวงค้นหาเมื่อจุดเดิมวางไม่ติด
    local reach = math.clamp(
        PLACE.ESC_MIN + PLACE.ESC_GROW * #tried,
        PLACE.ESC_MIN,
        PLACE.ESC_MAX
    )
    local rMin = (#tried == 0) and 0.5 or PLACE.ESC_MIN
    local bestX, bestZ, bestScore = nil, nil, -1

    for i = 1, 150 do
        local lim = (i > 75)
            and math.min(reach * 1.6, PLACE.ESC_MAX * 1.5)
            or reach
        local r = rMin + (math.max(lim, rMin) - rMin) * PLACE.rng:NextNumber()
        local theta = PLACE.rng:NextNumber() * math.pi * 2
        local dx, dz = math.cos(theta) * r, math.sin(theta) * r
        local candidateScore = score(dx, dz)

        if candidateScore >= PLACE.CLEAR then
            return dx, dz
        end
        if candidateScore > bestScore then
            bestX, bestZ, bestScore = dx, dz, candidateScore
        end
    end

    -- ไม่มีจุดที่ผ่านเกณฑ์ ให้ retry แทนการยิงตำแหน่งที่เสี่ยง
    return nil, nil
end

-- =====================================================================
--  วางไม่จำกัดพื้นที่ (CONFIG.PLACE_ANYWHERE)  ปรับตัวเลขได้ที่ตาราง ANY ด้านล่าง
--  ตอนลากวางยูนิต เกมจะมีตัวอย่าง (ghost) อยู่ที่ workspace.Game.PlacingTowers["<ชื่อยูนิต>"]
--    - Highlight ของมันสี 154,0,0 = จุดนั้นวางไม่ได้
--    - เกมใช้ระบบ: กดรอบแรก = แค่ย้ายตำแหน่ง ยังไม่วาง | กดรอบสองติดกัน = วาง (ใช้ตำแหน่ง "รอบแรก")
--  สคริปต์ทำ: กดรอบแรก -> รอ ghost นิ่งแล้วจดตำแหน่ง + สี | กดรอบสองติดกัน และจุดนั้นเป็นสีแดง
--             -> ยิง TowerAdd เองด้วย CFrame/Pos ของรอบแรก (UnitId หาจาก Slot ของเรา)
--  วางเสร็จ -> สคริปต์กดคีย์ X ให้เองทันที (ไม่มีสวิตช์ ทำงานตามระบบวางไม่จำกัดพื้นที่) ไม่รบกวนการเล่นมือถือ
--  จุดที่ไม่แดง (วางได้ปกติ) สคริปต์ไม่ยุ่ง ให้เกมวางเอง
-- =====================================================================
do
    local ANY = {
        WINDOW = 0.3,    -- กดรอบสองต้องตามมาภายในกี่วินาที ถึงนับว่า "กดสองรอบติด"
        SETTLE = 0.2,    -- รอให้ ghost ขยับตามที่กดรอบแรกเสร็จสูงสุดกี่วินาที
        COOLDOWN = 0.4,  -- หลังยิงแล้วพักกี่วินาที (กันยิงซ้ำ)
    }
    local UIS = game:GetService("UserInputService")
    local pending, lastFire = nil, -100

    local function colorBad(c)   -- อยู่ในกลุ่มสีแดง (เข้มหรืออ่อนก็นับ)
        if typeof(c) ~= "Color3" then return false end
        local h, s, v = c:ToHSV()
        local red = (h <= 0.05 or h >= 0.95)   -- โทนสีแดง
        return red and s >= 0.5 and v >= 0.25
    end

    local function findHighlight(g)
        local h = g:FindFirstChild("Highlight")
        if h then return h end
        return g:FindFirstChildWhichIsA("Highlight", true)
    end

    -- จุดนี้วางไม่ได้ไหม (Highlight สีแดง 154,0,0) -- เช็กหลายชื่อ property เผื่อ Highlight ไม่ใช่คลาส Highlight ตรงๆ
    local function ghostRed(g)
        local h = findHighlight(g)
        if not h then return false end
        for _, prop in ipairs({ "FillColor", "OutlineColor", "Color", "Color3" }) do
            local ok, v = pcall(function() return h[prop] end)
            if ok and colorBad(v) then return true end
        end
        return false
    end

    local function ghostCFrame(g)
        if g:IsA("Model") then return g:GetPivot() end
        return g.CFrame
    end

    -- ghost ที่กำลังลากวางอยู่ (เลือกตัวที่ชื่อตรงกับ Slot ของเรา ถ้าไม่มีก็ตัวแรกที่มี Highlight)
    local function currentGhost()
        local gm = workspace:FindFirstChild("Game")
        local folder = gm and gm:FindFirstChild("PlacingTowers")
        if not folder then return nil end
        local fallback
        for _, g in ipairs(folder:GetChildren()) do
            if (g:IsA("Model") or g:IsA("BasePart")) and findHighlight(g) then
                if slotUnitId(g.Name) then return g end
                fallback = fallback or g
            end
        end
        return fallback
    end

    -- รอบแรก: รอ ghost นิ่ง (2 เฟรมติด) แล้วจดตำแหน่ง/ชื่อ/สีแดงหรือไม่
    local function capture(first, ghost)
        local t0, last, still = os.clock(), nil, 0
        while alive and os.clock() - t0 < ANY.SETTLE do
            RunService.Heartbeat:Wait()
            if not ghost.Parent then return end
            local pos = ghostCFrame(ghost).Position
            if last and (pos - last).Magnitude < 0.01 then still = still + 1 else still = 0 end
            last = pos
            if os.clock() - t0 >= 0.06 and still >= 2 then break end
        end
        RunService.Heartbeat:Wait()   -- เผื่อสีอัปเดตช้ากว่าตำแหน่งหนึ่งเฟรม
        if not ghost.Parent then return end
        first.cf = ghostCFrame(ghost)
        first.name = ghost.Name
        first.red = ghostRed(ghost)
        first.done = true
    end

    -- =====================================================================
    --  วางเสร็จ -> กด X ให้เองทันที
    --  เกมนี้ไม่มีปุ่ม X ใน GUI -> หลังสคริปต์ยิง TowerAdd เอง ghost ยังค้างอยู่ -> จำลอง "คีย์บอร์ด X" ให้
    --  ใช้ VirtualInputManager:SendKeyEvent (คีย์บอร์ดเท่านั้น) ไม่แตะนิ้ว/จอยเดิน -> เล่นมือถือได้ปกติ
    -- =====================================================================
    local function pressKeyX()
        if not VirtualInputManager then return false end
        if PLAT.mobile() then return false end   -- มือถือใช้ปุ่ม ButtonX บนจอแทน
        local ok = pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.X, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.X, false, game)
        end)
        return ok
    end

    -- ระบบมือถือ: PlayerGui.GameUI.UserInputUI.Mobile.ButtonX (ใช้เมื่อ Mobile เปิดอยู่)
    local function mobileButtonX()
        local g = playerGui:FindFirstChild("GameUI")
        local inp = g and g:FindFirstChild("UserInputUI")
        local mob = inp and inp:FindFirstChild("Mobile")
        local btn = mob and mob:FindFirstChild("ButtonX")
        if btn and guiVisible(mob) and guiVisible(btn) then return btn end
        return nil
    end

    local function pressMobileX(btn)
        local b = clickable(btn)
        if clickButton(b) then return true end   -- สั่งปุ่มตรงๆ ไม่แตะนิ้ว
        return mouseClick(b)                      -- สำรอง (ไม่ทำตอนตัวละครกำลังเดินบนมือถือ)
    end

    local function closePlacing(ghostName)
        for try = 1, 3 do
            if not alive then return end
            local mb = mobileButtonX()
            local ok
            if mb then
                ok = pressMobileX(mb)            -- ระบบ 1: Mobile เปิดอยู่ -> กดปุ่ม ButtonX
                if not ok then ok = pressKeyX() end
            else
                ok = pressKeyX()                 -- ระบบ 2: คีย์บอร์ด X
            end
            if not ok then return end
            logf("กด X ปิดโหมดวาง (%s) ครั้งที่ %d [%s]", tostring(ghostName), try, mb and "มือถือ" or "คีย์บอร์ด")
            task.wait(0.25)
            if not currentGhost() then return end   -- โหมดวางปิดแล้ว จบเลย
        end
    end

    -- รอบสอง: ถ้าจุดรอบแรกเป็นสีแดง -> ยิง TowerAdd ด้วยตำแหน่งรอบแรก
    local function placeFromFirst(first)
        local t0 = os.clock()
        while alive and not first.done and os.clock() - t0 < 0.5 do task.wait() end
        if not (alive and CONFIG.PLACE_ANYWHERE and first.done and first.red and first.cf) then return end
        if os.clock() - lastFire < ANY.COOLDOWN then return end

        local id = slotUnitId(first.name)
        if not id then
            setStatus("วางไม่จำกัดพื้นที่: หา UnitId ของ " .. tostring(first.name) .. " ไม่เจอ", "warn", "x")
            return
        end
        local cf = first.cf
        local payload = { UnitId = id, CFrame = cf, Name = first.name, Pos = cf.Position }
        lastFire = os.clock()
        local ok, err = fire(towerAddRE, payload)
        if not ok then
            logf("วางไม่จำกัดพื้นที่: ยิง TowerAdd ไม่ได้: %s", tostring(err))
            return
        end
        logf("วางไม่จำกัดพื้นที่: %s ที่ (%.1f, %.1f, %.1f)", tostring(first.name), cf.X, cf.Y, cf.Z)
        task.spawn(closePlacing, first.name)   -- วางเสร็จ -> กด X ปิดโหมดวางให้เอง
        -- กำลังบันทึกมาโครอยู่ -> ส่งเข้าคิวบันทึกเหมือนที่เกมวางเอง (fire() ปิด hook ไว้ จึงต้องส่งเอง)
        if isRecording and not isPlaying and rec and rec.out then
            rec.seq = rec.seq + 1
            rec.out[#rec.out + 1] = { towerAddRE, table.pack(payload), rec.seq, os.clock() }
        end
    end

    track(UIS.InputBegan:Connect(function(input)
        if not alive or isPlaying then return end
        if not CONFIG.PLACE_ANYWHERE or not towerAddRE then pending = nil return end
        local ut = input.UserInputType
        if ut ~= Enum.UserInputType.MouseButton1 and ut ~= Enum.UserInputType.Touch then return end
        local ghost = currentGhost()
        if not ghost then pending = nil return end

        local now = os.clock()
        if pending and now - pending.t <= ANY.WINDOW then
            local first = pending
            pending = nil            -- ใช้ผลของรอบแรกแล้ว รอบถัดไปนับเป็นรอบแรกใหม่
            task.spawn(placeFromFirst, first)
        else
            local first = { t = now, done = false }
            pending = first
            task.spawn(capture, first, ghost)
        end
    end))
end

-- เดินไปใกล้ตำแหน่งวางก่อนวาง (สวิตช์ WALK_TO_PLACE ในส่วนที่ซ่อน)
--   RANGE = ระยะสูงสุดที่ยอมให้ห่างจากจุดวาง (สตั๊ด, แนวราบ) | ถ้าอยู่ใกล้กว่านี้แล้วจะไม่เดิน
--   อยากให้ห่างมากขึ้น/น้อยลงแก้เลข RANGE  (1 สตั๊ด = ประมาณ 0.28 เมตรจริง แต่ในแมพเรียกเป็นเมตรได้)
PLACE.RANGE, PLACE.TIMEOUT = 8, 12
function PLACE.walk(target, active)
    local ch = player.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local root = ch and ch:FindFirstChild("HumanoidRootPart")
    if not (hum and root and hum.Health > 0 and typeof(target) == "Vector3") then return false end
    local function dist()
        local d = root.Position - target
        return Vector3.new(d.X, 0, d.Z).Magnitude
    end
    if dist() <= PLACE.RANGE then return true end

    logf("เดินไปใกล้จุดวาง (ห่าง %.1f สตั๊ด -> เป้า ไม่เกิน %d)", dist(), PLACE.RANGE)
    local t0 = os.clock()
    local lastPos, lastMove, jumps = root.Position, os.clock(), 0
    while alive and active() and os.clock() - t0 < PLACE.TIMEOUT do
        if hum.Health <= 0 then break end
        if dist() <= PLACE.RANGE - 0.5 then break end
        -- จุดหมาย = จุดบนเส้นตรงระหว่างเรากับจุดวาง ห่างจุดวาง (RANGE - 1.5) สตั๊ด
        local flat = Vector3.new(root.Position.X - target.X, 0, root.Position.Z - target.Z)
        local dir = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(1, 0, 0)
        local g = target + dir * math.max(PLACE.RANGE - 1.5, 1)
        pcall(function() hum:MoveTo(Vector3.new(g.X, root.Position.Y, g.Z)) end)
        task.wait(0.15)
        -- ติดสิ่งกีดขวาง: ไม่ขยับเกิน 1.5 วิ = กระโดด (ลองไม่เกิน 3 ครั้ง) แล้วเลิกเดิน
        if (root.Position - lastPos).Magnitude > 0.5 then
            lastPos, lastMove = root.Position, os.clock()
        elseif os.clock() - lastMove > 1.5 then
            jumps = jumps + 1
            if jumps > 3 then break end
            pcall(function() hum.Jump = true end)
            lastMove = os.clock()
        end
    end
    pcall(function() hum:MoveTo(root.Position) end)   -- หยุดเดิน
    local okNear = dist() <= PLACE.RANGE + 1
    logf("เดินเสร็จ: ห่างจุดวาง %.1f สตั๊ด (%s)", dist(), okNear and "ใกล้พอ" or "ยังไกลอยู่ จะลองวางเลย")
    return okNear
end

local function playPlace(action, i, total, active, label)
    local cost, _, unknown = costInfo(action)
    local minDrop = math.max(1, (action.cost or 0) * 0.5)
    local firstT
    local failed = {}   -- จุดที่ยิง TowerAdd แล้วยูนิตไม่โผล่ เก็บเป็น { dx, dz } เทียบกับจุดที่บันทึกไว้ (ห้ามกลับไปจุดเหล่านี้)
    local originalPositionSent = false -- ส่งตำแหน่งที่บันทึกไว้ตรง ๆ ก่อนเสมอ

    local base = action.pos
    if typeof(base) ~= "Vector3" and typeof(action.cframe) == "CFrame" then base = action.cframe.Position end

    -- ก่อนวาง: เอา Id ของยูนิตที่ชื่อตรงกับที่บันทึกไว้ จาก Slot ของผู้เล่นมาใส่
    local liveId, liveSlot = resolveUnitId(action.name, active)
    if liveId then
        if liveId ~= action.unitId then
            logf("UnitId ของ %s: ใช้ %s (Slot%d) แทนที่บันทึกไว้ %s",
                tostring(action.name), liveId, liveSlot, tostring(action.unitId))
        end
        action.unitId = liveId
    else
        logf("⚠️ ไม่เจอยูนิต %s ใน Slot ของผู้เล่น ใช้ UnitId ที่บันทึกไว้ (%s)",
            tostring(action.name), tostring(action.unitId))
    end

    return runWithRetry({
        label = string.format("%s | #%d/%d วาง %s", label, i, total, tostring(action.name)),
        cost = cost, unknown = unknown,
        untilPlaced = true,   -- วนจนวางติด
        maxAttempts = PLACE.MAX_TRY,   -- พลาดครบจำนวนนี้ = ข้ามยูนิตนี้ (ตั้ง PLACE.MAX_TRY = nil ถ้าอยากวนไม่จบ)
        statKey = "placed", active = active,
        attempt = function(t0, n, probing)
            firstT = firstT or t0
            TD.scanUntil = os.clock() + 8
            TD.sniffUntil = os.clock() + 6
            action.unitId = slotUnitId(action.name) or action.unitId   -- เผื่อ Slot เปลี่ยนระหว่างรอเงิน

            -- รอบก่อนหน้าอาจ "วางติดช้า" (แล็ก) -> เช็กก่อนว่ามียูนิตโผล่แล้วหรือยัง จะได้ไม่ยิงซ้ำจนซ้อนกัน
            if firstT < t0 then
                local late = TD.pick(action, firstT - 0.3)
                if late then
                    TD.used[late.id] = true
                    logf("วาง %s: รอบก่อนวางติดช้า ใช้ยูนิตเดิม (Id %s)", tostring(action.name), tostring(late.id))
                    return true, late.id
                end
            end

            -- สวิตช์ซ่อน: เดินไปใกล้จุดวางก่อน (เดินเสร็จแล้วค่อยเริ่มนับเวลารอผลวาง)
            if CONFIG.WALK_TO_PLACE and OWN.is then
                if typeof(base) == "Vector3" and PLACE.walk(base, active) then t0 = os.clock() end
            end

            -- ครั้งแรกใช้ตำแหน่งเดิมจากมาโครแบบตรง ๆ ไม่สุ่มและไม่ขยับ
            -- ถ้าส่งแล้วตรวจไม่พบยูนิตเพิ่ม รอบถัดไปจึงค่อยหาจุดสุ่มใหม่
            local dx, dz
            local useOriginalPosition = not originalPositionSent
            if useOriginalPosition then
                dx, dz = 0, 0
            elseif typeof(base) == "Vector3" then
                dx, dz = PLACE.choose(base, failed)
            else
                dx, dz = PLACE.offset(1)
            end
            local cf, pos = action.cframe, action.pos

            -- ถ้าหาจุดสุ่มที่ผ่านเกณฑ์ไม่ได้ ให้รอบถัดไปลองใหม่
            if dx == nil or dz == nil then
                logf(
                    "วาง %s: ยังหาจุดที่ห่างจากยูนิตอื่นพอไม่ได้ จะลองใหม่",
                    tostring(action.name)
                )
                return false
            end

            -- ใช้ offset เฉพาะรอบสุ่มหลังจากตำแหน่งเดิมวางไม่ติด
            if not useOriginalPosition then
                local offset = Vector3.new(dx, 0, dz)
                if typeof(cf) == "CFrame" then
                    cf = cf + offset
                end
                if typeof(pos) == "Vector3" then
                    pos = pos + offset
                elseif typeof(pos) ~= "Vector3" and typeof(cf) == "CFrame" then
                    pos = cf.Position
                end
            end

            -- ใช้ตำแหน่งที่ส่งไปวางจริงในการตรวจจับผล
            local checkAction = {
    name = action.name,
    unitId = action.unitId,
    pos = pos or (typeof(cf) == "CFrame" and cf.Position or nil),
    cframe = cf,
}

-- เก็บยูนิตที่มีอยู่ก่อนส่งคำสั่ง เพื่อยืนยันว่ารอบนี้มีตัวใหม่เพิ่มจริง
local towersFolderAtFire = TD.towersFolder
local towersBefore = {}
local towerCountBefore
if towersFolderAtFire and towersFolderAtFire.Parent then
    local currentTowers = towersFolderAtFire:GetChildren()
    towerCountBefore = #currentTowers
    for _, tower in ipairs(currentTowers) do
        towersBefore[tower] = true
    end
end

local fireTime = os.clock()

local ok, err = fire(towerAddRE, {
    UnitId = action.unitId,
    CFrame = cf,
    Name = action.name,
    Pos = pos,
})

if not ok then
    logf("ยิง TowerAdd ไม่ได้: %s", tostring(err))
    return false
end

-- ยืนยันว่าได้ส่งตำแหน่งเดิมไปแล้ว; ถ้ายูนิตไม่เพิ่ม รอบ retry จะใช้จุดสุ่ม
if useOriginalPosition then
    originalPositionSent = true
end

-- ตรวจเฉพาะยูนิตที่เกิดหลังการลองวางรอบนี้
local placed, id = awaitPlaced(
    checkAction,
    fireTime,
    active,
    minDrop,
    fireTime
)

-- ยืนยันกับ workspace.Game.Towers ว่ามียูนิตใหม่เพิ่มจริง
-- อย่าใช้แค่เงินลดเป็นเงื่อนไขสำเร็จ เพราะถ้าจำนวนไม่เพิ่มต้องลองจุดสุ่มใหม่
if towersFolderAtFire and towersFolderAtFire.Parent and towerCountBefore ~= nil then
    local countDeadline = os.clock() + math.max(0.75, math.min(2, getPing() * 2 + 0.5))
    local newTower

    repeat
        for _, tower in ipairs(towersFolderAtFire:GetChildren()) do
            if not towersBefore[tower] then
                newTower = tower
                break
            end
        end
        if newTower then break end
        if not active() then break end
        task.wait(0.05)
    until os.clock() >= countDeadline

    if newTower then
        -- ถ้ามียูนิตเพิ่มแล้ว ให้นับว่าสำเร็จแม้ตัวจับ Id เดิมจะพลาด
        id = id or newTower.Name
        if id then TD.used[id] = true end
        placed = true
    else
        placed = false
        id = nil
        logf("วาง %s: จำนวนใน Towers ไม่เพิ่ม จะลองตำแหน่งสุ่มใหม่", tostring(action.name))
    end
end

if not placed and not probing and active() then
    failed[#failed + 1] = { dx, dz }

    if typeof(base) == "Vector3" then
        PLACE.markBad(
            Vector3.new(base.X + dx, base.Y, base.Z + dz)
        )
    end

    logf(
        "วาง %s ไม่สำเร็จที่ X%+.2f Z%+.2f -> จะลองจุดใหม่",
        tostring(action.name),
        dx,
        dz
    )
end

return placed, id
        end,
    })
end

-- Id ของยูนิตในเกมนี้ (ใช้ร่วมกันทั้งอัปเกรดและขาย ต้องเป็นเลขเดียวกัน)
function TD.refId(action, ref, placedMap)
    local id = ref and placedMap[ref] or nil
    if not id and ref then
        local pa = recordedActions[ref]
        local c = pa and TD.pick(pa, (TD.roundT or 0) - 0.3)
        if c then
            TD.used[c.id] = true
            id = c.id
            logf("เก็บ Id ย้อนหลังของ #%d -> %s", ref, tostring(id))
        end
    end
    if not id then id = action.tid end
    if id and ref then placedMap[ref] = id end
    return id
end

local function playUpgrade(action, i, total, active, label, placedMap, failedRef, soldRef)
    local ref = action.unitRef
    if ref and failedRef[ref] then
        logf("ข้าม #%d: ยูนิตอ้างอิง #%d วางไม่สำเร็จ", i, ref)
        return "skipped"
    end
    if ref and soldRef and soldRef[ref] then
        logf("ข้าม #%d: ยูนิต #%d ถูกขายไปแล้ว", i, ref)
        return "skipped"
    end

    local id = TD.refId(action, ref, placedMap)
    if not id then
        logf("ข้าม #%d: ไม่รู้ Id ของยูนิต", i)
        return "skipped"
    end

    local cost, _, unknown = costInfo(action)
    local minDrop = math.max(1, (action.cost or 0) * 0.5)
    local firstT, before
    local refName = ref and recordedActions[ref] and recordedActions[ref].name or "?"
    return runWithRetry({
        label = string.format("%s | #%d/%d อัปเกรด %s", label, i, total, tostring(refName)),
        cost = cost, unknown = unknown, maxAttempts = CONFIG.UPGRADE_RETRIES,
        statKey = "upgraded", active = active,
        attempt = function(t0)
            firstT = firstT or t0
            before = before or ((TD.upg[id] and TD.upg[id].level) or 0)
            TD.sniffUntil = os.clock() + 6
            local ok, err = fire(towerUpgradeRE, { Id = id })
            if not ok then
                logf("ยิง TowerUpgrade ไม่ได้: %s", tostring(err))
                return false
            end
            local deadline = t0 + math.max(0.8, getPing() * 2 + 0.6)
            while os.clock() < deadline and active() do
                local u = TD.upg[id]
                if u and u.t >= firstT - 0.02 and (not u.level or u.level > before) then return true end
                if moneyOK() and spendSince(firstT, minDrop) then return true end
                task.wait(0.05)
            end
            return false
        end,
    })
end

-- ยูนิตยังอยู่ใน workspace.Game.Towers ไหม  true/false | nil = เช็กไม่ได้ (ไม่มีโฟลเดอร์)
function TD.towerAlive(id)
    local f = TD.towersFolder
    if not (f and f.Parent) then return nil end
    return f:FindFirstChild(tostring(id)) ~= nil
end

-- ขายยูนิต: ยิง TowerSell { Id = ... } (Id เดียวกับตอนวาง/อัปเกรด)  สำเร็จ = ยูนิตหายจาก Towers
local function playSell(action, i, total, active, label, placedMap, failedRef, soldRef)
    local ref = action.unitRef
    if ref and failedRef[ref] then
        logf("ข้าม #%d: ยูนิตอ้างอิง #%d วางไม่สำเร็จ", i, ref)
        return "skipped"
    end
    if ref and soldRef[ref] then
        logf("ข้าม #%d: ยูนิต #%d ถูกขายไปแล้ว", i, ref)
        return "skipped"
    end

    local id = TD.refId(action, ref, placedMap)
    if not id then
        logf("ข้าม #%d: ไม่รู้ Id ของยูนิตที่จะขาย", i)
        return "skipped"
    end

    local refName = ref and recordedActions[ref] and recordedActions[ref].name or "?"
    local existed = TD.towerAlive(id)   -- true = ตรวจผลได้ว่าหายไปจริงไหม
    local res = runWithRetry({
        label = string.format("%s | #%d/%d ขาย %s", label, i, total, tostring(refName)),
        cost = 0, unknown = false, maxAttempts = CONFIG.UPGRADE_RETRIES,
        statKey = "sold", active = active,
        attempt = function(t0)
            local ok, err = fire(towerSellRE, { Id = id })
            if not ok then
                logf("ยิง TowerSell ไม่ได้: %s", tostring(err))
                return false
            end
            if existed ~= true then
                task.wait(0.3)   -- ตรวจไม่ได้ ถือว่าสำเร็จหลังยิง
                return true
            end
            local deadline = t0 + math.max(1.0, getPing() * 2 + 0.8)
            while os.clock() < deadline and active() do
                if TD.towerAlive(id) == false then return true end
                task.wait(0.05)
            end
            return false
        end,
    })
    if res == "ok" and ref then soldRef[ref] = true end
    return res
end

-- รอเวฟตามที่แถวกำหนด (action.wave > 0)  คืน "ok" | "aborted" | "gameover"
local function waitForWave(action, active, label, i, total)
    local need = tonumber(action.wave) or 0
    if need <= 0 or not CONFIG.WAVE_GATE then return "ok" end
    local lastNotice, nilSince = 0, nil
    while true do
        if not active() then return "aborted" end
        if isGameOver() then return "gameover" end
        local cur = getWave()
        local now = os.clock()
        if cur == nil then
            nilSince = nilSince or now
            if now - nilSince > 3 then
                if not TD.waveWarned then
                    TD.waveWarned = true
                    setStatus("อ่านเวฟไม่ได้ ข้ามการรอเวฟ (ลองปุ่ม 'ทดสอบอ่านเวฟ' ในแท็บ Editor)", "warn", "hourglass")
                end
                return "ok"
            end
        else
            nilSince = nil
            if cur >= need then return "ok" end
            if now - lastNotice > 1 then
                lastNotice = now
                setQuiet(string.format("%s | #%d/%d รอเวฟ %d (ตอนนี้เวฟ %d)", label, i, total, need, cur))
            end
        end
        task.wait(0.15)
    end
end

-- เล่นแอคชันทั้งหมด 1 รอบ  คืน "done" | "gameover" | "aborted"
local function playActions(active, label)
    TD.used = {}
    TD.roundT = os.clock()
    local placedMap, failedRef, soldRef = {}, {}, {}
    local total = #recordedActions
    for i, action in ipairs(recordedActions) do
        if not active() then return "aborted" end
        if isGameOver() then return "gameover" end

        local ww = waitForWave(action, active, label, i, total)
        if ww ~= "ok" then return ww end

        local st, extra
        if action.type == "Place" then
            if towerAddRE then
                st, extra = playPlace(action, i, total, active, label)
                if st == "ok" then
                    if extra then placedMap[i] = extra end
                elseif st == "failed" then
                    failedRef[i] = true
                end
            end
        elseif action.type == "Upgrade" then
            if towerUpgradeRE then
                st = playUpgrade(action, i, total, active, label, placedMap, failedRef, soldRef)
            end
        elseif action.type == "Sell" then
            if towerSellRE then
                st = playSell(action, i, total, active, label, placedMap, failedRef, soldRef)
            else
                logf("ข้าม #%d: ไม่พบ Remote TowerSell", i)
            end
        end
        if st == "aborted" or st == "gameover" then return st end
        task.wait()
    end
    return "done"
end

-- =====================================================================
--  เริ่มเกม (โหวตโหมด) / จบเกม (PlayAgain) / ต่อหลังย้ายเซิร์ฟ
-- =====================================================================
local function waitRoundStart(active, label)
    local t0 = os.clock()
    while active() do
        if isGameOver() then return "gameover" end
        if votingOpen() then break end
        if os.clock() - t0 > CONFIG.VOTE_WAIT then
            logf("ไม่เจอหน้าโหวตโหมดภายใน %d วิ ถือว่าเกมเริ่มแล้ว", CONFIG.VOTE_WAIT)
            return "started"
        end
        setQuiet(string.format("รอบ %s | รอหน้าโหวตโหมด", label))
        task.wait(0.1)
    end
    if not active() then return "aborted" end

    local vote = macroMeta.vote
    local votedAt, voteTries = -10, 0
    local tOpen = os.clock()
    while active() and votingOpen() and os.clock() - tOpen < CONFIG.VOTE_CLOSE_WAIT do
        if vote and #vote > 0 and modeVoteRE and voteTries < 4 and os.clock() - votedAt >= 3 then
            voteTries = voteTries + 1
            votedAt = os.clock()
            TD.sniffUntil = os.clock() + 6
            fire(modeVoteRE, table.unpack(vote, 1, #vote))
            logf("โหวตโหมด: %s (ครั้งที่ %d)", short(vote[1], 0), voteTries)
            setQuiet(string.format("รอบ %s | โหวตโหมด: %s", label, TD.voteText(vote)))
        end
        task.wait(0.1)
    end
    if not active() then return "aborted" end

    local delay = CONFIG.START_DELAY
    if delay > 0 then
        setQuiet(string.format("รอบ %s | เริ่มใน %d วิ", label, delay))
        local t = os.clock()
        while active() and os.clock() - t < delay do task.wait(0.1) end
    end
    return active() and "started" or "aborted"
end

-- ----- resume (เล่นต่อหลังย้ายเซิร์ฟ) -----
local function clearResume()
    if isfile and delfile and isfile(RESUME_FILE) then pcall(delfile, RESUME_FILE) end
end

local function saveResume(completed, total, forever)
    if not (writefile and CONFIG.AUTO_RESUME and selectedName) then return end
    local data = {
        playing = true, ts = os.time(), gameId = game.GameId, name = selectedName,
        round = completed, total = forever and 0 or total, forever = forever and true or false,
        stats = {
            rounds = stats.rounds, placed = stats.placed, upgraded = stats.upgraded, sold = stats.sold,
            retries = stats.retries, failures = stats.failures, replayClicks = stats.replayClicks,
            lastRound = stats.lastRound, totalRoundTime = stats.totalRoundTime,
        },
    }
    pcall(function() writefile(RESUME_FILE, HttpService:JSONEncode(data)) end)
end

-- เกมจบ -> กด PlayAgain  คืน "ok" | "stopped" | "aborted"
local function goPlayAgain(active, label, completed, total, forever)
    if not CONFIG.AUTO_REPLAY then
        while active() and isGameOver() do
            setQuiet(string.format("รอบ %s | เกมจบ รอกด PlayAgain เอง", label))
            task.wait(0.5)
        end
        return active() and "ok" or "aborted"
    end

    task.wait(0.3)
    saveResume(completed, total, forever)   -- เซฟก่อนกด เพราะเซิร์ฟที่ย้ายไปต้องรู้ว่าเล่นถึงไหนแล้ว

    local tries, attempt = 0, 0
    while active() and isGameOver() do
        if tries >= CONFIG.REPLAY_MAX_TRIES then
            if not forever then return "stopped" end
            setQuiet(string.format("รอบ %s | กด PlayAgain ไม่ติด พัก 8 วิแล้วลองใหม่", label))
            local t = os.clock()
            while active() and os.clock() - t < 8 do task.wait(0.2) end
            tries = 0
        end
        tries = tries + 1
        attempt = attempt + 1
        stats.replayClicks = stats.replayClicks + 1

        local btn = gameUI("FinalUI", "Content", "PlayAgain")
        if not btn then
            setQuiet(string.format("รอบ %s | ยังไม่เจอปุ่ม PlayAgain", label))
        else
            setQuiet(string.format("รอบ %s | กด PlayAgain (%d/%d)", label, tries, CONFIG.REPLAY_MAX_TRIES))
            local okc, errc = pcall(pressObj, btn, "PlayAgain", attempt)
            if not okc then logf("กด PlayAgain error: %s", tostring(errc)) end
        end

        -- กดแล้วเกมจะนับถอยหลัง (~5 วิ) ห้ามกดซ้ำระหว่างนั้น -> รอ REPLAY_WAIT วิ (ค่าเริ่มต้น 7)
        -- ถ้าเกมย้ายเซิร์ฟ สคริปต์ตัวนี้จะถูกปิดไปเอง / ถ้าครบเวลาแล้วหน้าจบเกมยังอยู่ ค่อยกดใหม่
        if btn then
            local e = 0
            while e < CONFIG.REPLAY_WAIT and active() and isGameOver() do
                setQuiet(string.format("รอบ %s | กด PlayAgain แล้ว รอเกมนับถอยหลัง %d วิ", label,
                    math.ceil(CONFIG.REPLAY_WAIT - e)))
                task.wait(0.2)
                e = e + 0.2
            end
        else
            task.wait(0.5)
        end
    end
    if not active() then return "aborted" end
    return "ok"
end

-- ----- สถิติ -----
local function fmtTime(sec)
    sec = math.max(0, math.floor(sec or 0))
    return string.format("%d:%02d:%02d", sec // 3600, (sec % 3600) // 60, sec % 60)
end

local function statsText()
    local avg = stats.rounds > 0 and (stats.totalRoundTime / stats.rounds) or 0
    local session = stats.sessionStart and (os.clock() - stats.sessionStart) or 0
    return table.concat({
        string.format("รอบที่เล่นจบ: %d", stats.rounds),
        string.format("วางยูนิต: %d | อัปเกรด: %d | ขาย: %d", stats.placed, stats.upgraded, stats.sold),
        string.format("ลองซ้ำ: %d | ล้มเหลว: %d", stats.retries, stats.failures),
        string.format("กด PlayAgain: %d", stats.replayClicks),
        string.format("รอบล่าสุด: %s | เฉลี่ย: %s", fmtTime(stats.lastRound), fmtTime(avg)),
        string.format("เวลาที่รันสคริปต์: %s", fmtTime(session)),
        moneyOK() and ("เงินตอนนี้: " .. fmtNum(getMoney())) or "เงินตอนนี้: อ่านไม่ได้",
    }, "\n")
end

-- ----- ลูปหลัก: เล่นกี่รอบก็ได้ (total = math.huge = ไม่จำกัด) -----
local function runLoops(total, startCompleted, waitForGame)
    if isPlaying then return end
    if isRecording then
        setStatus("หยุดบันทึกก่อนจึงจะเล่นได้", "warn", "square")
        return
    end
    if #recordedActions == 0 then
        setStatus("ยังไม่มีมาโครให้เล่น (บันทึกหรือโหลดก่อน)", "warn", "x")
        return
    end
    if not (towerAddRE and towerUpgradeRE) then
        setStatus("ระบบยังไม่พร้อม ลองเข้าเกมใหม่อีกครั้ง", "bad", "x")
        return
    end
    if not inGame() and not waitForGame then
        setStatus("ตอนนี้อยู่ลอบบี้ เล่นมาโครได้เฉพาะตอนอยู่ในเกม", "warn", "flag")
        return
    end
    if not moneyOK() then
        notify("อ่านเงินไม่ได้ จะเล่นโดยไม่รอเงิน", nil, 5, "coins")
    end

    local forever = (total == math.huge)
    TD.playCtx = { total = total, forever = forever, completed = startCompleted or 0 }   -- ใช้ตอนออกไปสุ่มตัว
    isPlaying = true
    playToken = playToken + 1
    local my = playToken
    local function active() return alive and isPlaying and playToken == my end
    stats.sessionStart = stats.sessionStart or os.clock()
    refreshAll()

    task.spawn(function()
        local completed = startCompleted or 0
        local stopMsg
        local okRun, errRun = pcall(function()
            -- เล่นต่อหลังย้ายเซิร์ฟ: รอจน GamemodeVoting โผล่ (GUI ของเกมยังโหลดไม่เสร็จ)
            if waitForGame then
                local tw = os.clock()
                while active() and not inGame() and os.clock() - tw < 90 do
                    setQuiet("รอเข้าเกม")
                    task.wait(0.5)
                end
                if active() and not inGame() then
                    stopMsg = "รอเข้าเกมนานเกิน 90 วิ ไม่เล่นต่อ"
                end
            end

            while active() and not stopMsg and (forever or completed < total) do
                local label = string.format("%d/%s", completed + 1, forever and "∞" or tostring(total))

                if not inGame() then
                    -- หลุดออกจากเกม/กลับลอบบี้: รอเฉยๆ ไม่ทำอะไร
                    setQuiet(string.format("รอบ %s | ไม่อยู่ในเกม รอเข้าเกม", label))
                    task.wait(0.5)
                else

                -- A) หน้าจบเกมค้างอยู่ -> (ถ้าตู้รีเซ็ตรออยู่ ไปลอบบี้เลย ไม่กด PlayAgain) -> PlayAgain
                if isGameOver() then
                    if TD.sumShouldLeave and TD.sumShouldLeave() then
                        task.spawn(TD.sumLeave)   -- stopAll ข้างในจะปิดลูปนี้เอง
                        break
                    end
                    local r = goPlayAgain(active, label, completed, total, forever)
                    if r == "stopped" then
                        stopMsg = "กด PlayAgain ไม่ติด หยุดเล่น"
                        break
                    elseif r ~= "ok" then
                        break
                    end
                end

                -- B) รอเกมเริ่ม + โหวตโหมด
                local st = waitRoundStart(active, label)
                if st == "aborted" then break end

                if st == "started" then
                    local roundStart = os.clock()
                    logf("เริ่มรอบ %s", label)
                    local result = playActions(active, label)
                    if result == "aborted" then break end

                    -- C) รอเกมจบ (AutoSkip จะข้ามเวฟให้เอง)
                    while active() and not isGameOver() do
                        setQuiet(string.format("รอบ %s | วางครบแล้ว รอเกมจบ", label))
                        task.wait(0.15)
                    end
                    if not active() then break end

                    local dur = os.clock() - roundStart
                    completed = completed + 1
                    if TD.playCtx then TD.playCtx.completed = completed end
                    stats.rounds = stats.rounds + 1
                    stats.lastRound = dur
                    stats.totalRoundTime = stats.totalRoundTime + dur
                    logf("จบรอบ %s ใช้เวลา %s", label, fmtTime(dur))
                    RPT.round(RPT.read(), RPT.readTime() or dur)
                    refreshAll()
                end
                end -- inGame()
            end
        end)

        if not okRun then
            logf("runLoops error: %s", tostring(errRun))
            stopMsg = "เกิดข้อผิดพลาด หยุดเล่น"
        end
        if playToken == my then
            isPlaying = false
            clearResume()
            refreshAll()
            setQuiet("ว่าง")
            if alive then
                setStatus(stopMsg or string.format("เล่นครบ %d รอบแล้ว", completed), stopMsg and "warn" or "ok", "trophy")
            end
        end
    end)
end

local function stopAll(reason)
    local wasPlaying, wasRec = isPlaying, isRecording
    if isRecording then finishRecording("หยุดบันทึก") end   -- ตอนบันทึกจะมีข้อความสรุปของมันเอง
    isPlaying = false
    playToken = playToken + 1
    clearResume()
    refreshAll()
    setQuiet("ว่าง")
    if wasPlaying and not wasRec then setStatus(reason or "หยุดเล่นแล้ว", "warn", "square") end
end

-- ----- ต่อหลังย้ายเซิร์ฟ -----
local function setupQueue()
    if not (CONFIG.AUTO_RESUME and queue_on_teleport) then return "ไม่ใช้ / executor ไม่รองรับ" end
    local src
    if SCRIPT_URL ~= "" then
        src = string.format("loadstring(game:HttpGet(%q))()", SCRIPT_URL)
    elseif SCRIPT_FILE ~= "" then
        src = string.format("loadstring(readfile(%q))()", SCRIPT_FILE)
    end
    if not src then return "ต้องวางสคริปต์ใน autoexec" end
    local ok = pcall(queue_on_teleport, src)
    return ok and "พร้อม" or "ใช้ไม่ได้"
end

local function tryResume()
    if not (isfile and readfile and isfile(RESUME_FILE)) then return end
    local ok, d = pcall(function() return HttpService:JSONDecode(readfile(RESUME_FILE)) end)
    if not ok or type(d) ~= "table" or not d.playing then return end
    if not (CONFIG.AUTO_RESUME or d.fromSummon) then return end   -- fromSummon = กลับมาจากการสุ่มตัวในลอบบี้
    if os.time() - (tonumber(d.ts) or 0) > (tonumber(d.maxAge) or CONFIG.RESUME_MAX_AGE) then
        log("ไฟล์ resume เก่าเกินไป ไม่เล่นต่อ")
        clearResume()
        return
    end
    if d.gameId and d.gameId ~= game.GameId then
        clearResume()
        return
    end
    local actions, meta = loadMacro(tostring(d.name))
    if not actions then
        log("resume: โหลดมาโคร " .. tostring(d.name) .. " ไม่ได้")
        clearResume()
        return
    end

    recordedActions, macroMeta, selectedName = actions, meta or { vote = nil }, tostring(d.name)
    macroDirty = false
    if type(d.stats) == "table" then
        for k, v in pairs(d.stats) do
            if type(v) == "number" and stats[k] ~= nil then stats[k] = v end
        end
    end
    refreshAll()

    local forever = d.forever == true
    local total = forever and math.huge or math.max(1, tonumber(d.total) or 1)
    local completed = tonumber(d.round) or 0
    if not forever and completed >= total then
        clearResume()
        return
    end
    notify(string.format("ย้ายเซิร์ฟแล้ว เล่นต่อจากรอบที่ %d", completed + 1), nil, 5, "play")
    logf("resume: %s รอบที่ %d", selectedName, completed + 1)
    task.wait(3)   -- ให้ GUI ของเกมโหลดก่อน
    if alive then runLoops(total, completed, true) end
end

-- ----- AutoSkip: UIStroke โซนแดง = ปิด / ไม่แดง = เปิด -----
local AS = { fail = 0, nextAt = 0, seen = 0 }

-- เวฟปัจจุบันอยู่ในรายการ "ไม่ข้าม" ไหม
function AS.blocked()
    local list = CONFIG.NOSKIP_WAVES
    if type(list) ~= "table" or #list == 0 then return false end
    local w = getWave()
    if not w then return false end
    for _, n in ipairs(list) do
        if n == w then return true end
    end
    return false
end

local function skipZone()
    local btn = gameUI("Stats", "AutoSkip", "Button")
    local stroke = btn and btn:FindFirstChild("UIStroke")
    if not stroke then return nil, btn end
    local color
    local grad = stroke:FindFirstChildOfClass("UIGradient")
    if grad then
        local okk, kps = pcall(function() return grad.Color.Keypoints end)
        if okk and kps and #kps > 0 then
            local r, g, b = 0, 0, 0
            for _, k in ipairs(kps) do
                r, g, b = r + k.Value.R, g + k.Value.G, b + k.Value.B
            end
            color = Color3.new(r / #kps, g / #kps, b / #kps)
        end
    end
    color = color or stroke.Color
    local h, s, v = color:ToHSV()
    local red = s >= 0.35 and v >= 0.3 and (h <= 0.06 or h >= 0.94)
    return red and "red" or "on", btn
end

local function skipStateText()
    local zone, btn = skipZone()
    if not btn then return "ไม่พบปุ่ม" end
    if not zone then return "ไม่พบสถานะ" end
    return zone == "red" and "ปิด" or "เปิด"
end

-- ----- GameSpeed: GameUI.GameSpeeds["1" / "1.5" / "2" ...].TroopFrame.Background.UIShadow -----
-- UIShadow สี (8, 138, 12) = ตัวที่กำลังใช้อยู่
local GS = { fail = 0, nextAt = 0, seen = 0 }
local GS_TARGET = { 8, 138, 12 }

-- รายการปุ่มความเร็วที่มีในเกม เรียงจากน้อยไปมาก  { {n=1.5, name="1.5", obj=...}, ... }
local function speedList()
    local root = gameUI("GameSpeeds")
    if not root then return nil end
    local list = {}
    for _, c in ipairs(root:GetChildren()) do
        local n = tonumber(c.Name)
        if n then list[#list + 1] = { n = n, name = c.Name, obj = c } end
    end
    table.sort(list, function(a, b) return a.n < b.n end)
    return list
end

local function colorIsActive(c)
    return math.abs(c.R * 255 - GS_TARGET[1]) <= 14
        and math.abs(c.G * 255 - GS_TARGET[2]) <= 14
        and math.abs(c.B * 255 - GS_TARGET[3]) <= 14
end

-- true = กำลังใช้อยู่ / false = ไม่ใช้ / nil = ไม่เจอ UIShadow
-- (ไม่รู้ว่า UIShadow เป็นคลาสอะไร เลยลองอ่านสีจากทุกพร็อพที่เป็นไปได้ ถ้าตัวใดตัวหนึ่งตรงสีเขียวก็ถือว่าเปิดอยู่)
local function speedActive(frame)
    local tf = frame:FindFirstChild("TroopFrame")
    local bg = tf and tf:FindFirstChild("Background")
    local sh = bg and bg:FindFirstChild("UIShadow")
    if not sh then return nil end
    for _, prop in ipairs({ "Color", "Color3", "ImageColor3", "BackgroundColor3" }) do
        local ok, v = pcall(function() return sh[prop] end)
        if ok and typeof(v) == "Color3" and colorIsActive(v) then return true end
    end
    return false
end

local function activeSpeedName()
    local list = speedList()
    if not list then return nil end
    for _, it in ipairs(list) do
        if speedActive(it.obj) == true then return it.name end
    end
    -- สีไม่ขึ้น แต่แจ้งเตือนเพิ่งบอกว่าเปลี่ยนเป็นตัวนี้ -> ถือว่าตัวนี้ใช้อยู่
    if GS.notif then
        for _, it in ipairs(list) do
            if tonumber(it.name) == tonumber(GS.notif) then return it.name end
        end
    end
    return nil
end

-- ปุ่มของความเร็วนั้นๆ: GameSpeeds[ชื่อ].TroopFrame.InteractiveButton (ไม่ไต่ขึ้นไปหาพ่อ กันไปกดปุ่มอื่น)
local function speedButtonOf(frame)
    local tf = frame:FindFirstChild("TroopFrame")
    local b = tf and tf:FindFirstChild("InteractiveButton")
    if b then
        if b:IsA("GuiButton") then return b end
        return b:FindFirstChildWhichIsA("GuiButton", true) or b
    end
    return frame:FindFirstChildWhichIsA("GuiButton", true) or frame
end

-- กดทีละวิธี (เดิมกดทั้ง 2 วิธีพร้อมกันทุกครั้ง -> เมาส์จำลองทำให้เดินไม่ได้บนมือถือ)
--   ครั้งคี่ = สั่ง connection / firesignal ของปุ่ม (ไม่แตะอินพุต)
--   ครั้งคู่ = จำลองเมาส์คลิกกลางปุ่ม (มือถือ: ข้ามเองถ้ากำลังเดินอยู่ แล้วใช้วิธีแรกแทน)
local function pressSpeed(frame, attempt)
    attempt = attempt or 1
    local btn = speedButtonOf(frame)
    local fired, clicked = false, false
    if attempt % 2 == 1 then
        fired = clickButton(btn)
    end
    if not fired then
        if btn.AbsoluteSize.X > 0 and btn.AbsoluteSize.Y > 0 then
            clicked = mouseClick(btn)
        end
        if not clicked then fired = clickButton(btn) end
    end
    return fired, clicked, btn
end

-- ---- ยืนยันจากแจ้งเตือน: GameUI.Notifications.Actions.Title ----
-- ข้อความประมาณ "xxx just changed the game speed to 1.5!"  ขอแค่มี "speed to <ตัวเลข>!"
-- เจอแล้วถือว่าเปลี่ยนความเร็วเป็นตัวนั้นแล้ว (แม้สี UIShadow จะไม่เปลี่ยน)
-- แจ้งเตือนล่าสุดชนะเสมอ (ถ้าถูกเปลี่ยนเป็นตัวอื่นทีหลัง ก็ไม่ถือว่ายืนยันแล้ว)
GS.notif = nil   -- ความเร็วล่าสุดที่แจ้งเตือนบอก (string เช่น "1.5")

local function readSpeedNotif(label)
    local ok, txt = pcall(function() return label.Text end)
    if not ok or type(txt) ~= "string" then return end
    txt = txt:gsub("<[^>]+>", ""):lower()
    local n = txt:match("speed to%s+([%d%.]+)!")
    if n and GS.notif ~= n then
        GS.notif = n
        logf("GameSpeed: แจ้งเตือนบอกว่าเปลี่ยนเป็น x%s แล้ว", n)
    end
end

local function hookNotifLabel(d)
    if d.Name ~= "Title" then return end
    if not (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) then return end
    if GS.hookedLabels[d] then return end
    GS.hookedLabels[d] = true
    readSpeedNotif(d)
    track(d:GetPropertyChangedSignal("Text"):Connect(function()
        if alive then readSpeedNotif(d) end
    end))
end

GS.hookedLabels = setmetatable({}, { __mode = "k" })
GS.actions = nil

-- ผูกกับ Notifications.Actions (เรียกซ้ำได้ ผูกใหม่ถ้าเกมสร้าง GUI ใหม่)
local function hookNotifications()
    local acts = gameUI("Notifications", "Actions")
    if not acts or GS.actions == acts then return end
    GS.actions = acts
    for _, d in ipairs(acts:GetDescendants()) do hookNotifLabel(d) end
    track(acts.DescendantAdded:Connect(function(d)
        if alive then hookNotifLabel(d) end
    end))
    log("ผูกระบบตรวจความเร็วแล้ว")
end

local function notifConfirms(pick)
    return GS.notif ~= nil and tonumber(GS.notif) ~= nil and tonumber(GS.notif) == tonumber(pick)
end

local function speedTick()
    if not (CONFIG.GAMESPEED_ON and CONFIG.GAMESPEED_PICK ~= "") or not inGame() then
        GS.seen = 0
        return
    end
    pcall(hookNotifications)

    -- มี UI หน้าเลือกโหมด / หน้าจบเกม อยู่ = ไม่ทำงานเลย (ไม่เช็ก ไม่กด)
    -- ความเร็วถูกรีเซ็ตช่วงนี้ เลยลืมข้อความยืนยันเก่าทิ้ง แล้วรอจน UI หายค่อยเริ่มเช็กใหม่
    if isGameOver() or votingOpen() then
        GS.notif = nil
        GS.seen, GS.fail = 0, 0
        return
    end

    local root = gameUI("GameSpeeds")
    local frame = root and root:FindFirstChild(CONFIG.GAMESPEED_PICK)
    if not frame or not guiVisible(frame) then
        GS.seen = 0
        return
    end

    -- ยืนยันจากแจ้งเตือน "speed to <pick>!" = ถือว่าเปลี่ยนแล้ว (ไม่สนสี)
    if notifConfirms(CONFIG.GAMESPEED_PICK) then
        GS.seen, GS.fail = 0, 0
        return
    end

    local active = speedActive(frame)
    if active == nil then return end
    if active then
        GS.seen, GS.fail = 0, 0
        return
    end
    GS.seen = GS.seen + 1
    if GS.seen >= 2 and os.clock() >= GS.nextAt then
        GS.fail = GS.fail + 1
        local okp = pcall(pressSpeed, frame, GS.fail)
        if okp then
            logf("GameSpeed: กด x%s (ครั้งที่ %d)", CONFIG.GAMESPEED_PICK, GS.fail)
        else
            log("GameSpeed: กดไม่สำเร็จ")
        end
        GS.nextAt = os.clock() + (GS.fail >= 6 and 15 or 1.5)   -- กดไม่ติดหลายรอบ = พักนานขึ้น ไม่รัวกดรบกวนการเดิน
    end
end

-- ----- ลดกระตุก (ย้ายของออกจากฉากชั่วคราว ปิดแล้วเอากลับที่เดิม) -----
--  เปิด: ย้ายของใน Lighting ทั้งหมด + ทุก Part ใน workspace.Game.Paths ที่สีไม่ใช่ (65,66,75) ออกไปเก็บไว้ (Parent = nil)
--  ปิด: ย้ายกลับ Parent เดิมทั้งหมด (ไม่ได้ลบทิ้งจริง)
local LAG = { want = false, applied = false, busy = false, moved = {}, KEEP = { 65, 66, 75 }, BATCH = 150 }

local function lagIsKeep(part)
    local c = part.Color
    return math.abs(c.R * 255 - LAG.KEEP[1]) < 1.5
        and math.abs(c.G * 255 - LAG.KEEP[2]) < 1.5
        and math.abs(c.B * 255 - LAG.KEEP[3]) < 1.5
end

local function lagPaths()
    local g = workspace:FindFirstChild("Game")
    return g and g:FindFirstChild("Paths")
end

local function lagApply()
    local n = 0
    local function stash(inst)
        LAG.moved[#LAG.moved + 1] = { inst = inst, parent = inst.Parent }
        pcall(function() inst.Parent = nil end)
        n = n + 1
        if n % LAG.BATCH == 0 then task.wait() end
    end

    -- Lighting: ย้ายของข้างในออกทั้งหมด (Sky / Atmosphere / เอฟเฟกต์ต่างๆ)
    local lighting = game:GetService("Lighting")
    for _, ch in ipairs(lighting:GetChildren()) do
        if not LAG.want then return end
        stash(ch)
    end

    -- Paths: เก็บเฉพาะ Part สี (65,66,75)
    local paths = lagPaths()
    if not paths then return end
    local desc = paths:GetDescendants()
    local protect = {}   -- Part ที่มีลูกสีที่ต้องเก็บอยู่ข้างใน ห้ามย้าย (ไม่งั้นลูกหายไปด้วย)
    for _, d in ipairs(desc) do
        if d:IsA("BasePart") and lagIsKeep(d) then
            local a = d.Parent
            while a and a ~= paths do
                protect[a] = true
                a = a.Parent
            end
        end
    end
    for _, d in ipairs(desc) do
        if not LAG.want then return end
        if d:IsA("BasePart") and not protect[d] and not lagIsKeep(d) and d:IsDescendantOf(paths) then
            stash(d)
        end
    end
end

local function lagRestore()
    local list = LAG.moved
    LAG.moved = {}
    for i = #list, 1, -1 do   -- ย้อนกลับจากตัวท้าย ให้ลูกกลับเข้าพ่อก่อนพ่อกลับที่เดิม
        local it = list[i]
        pcall(function() it.inst.Parent = it.parent end)
        if i % LAG.BATCH == 0 then task.wait() end
    end
end

local function lagWorker()
    if LAG.busy then return end
    LAG.busy = true
    task.spawn(function()
        while true do
            if LAG.want and not LAG.applied then
                LAG.applied = true
                lagApply()
            elseif not LAG.want and LAG.applied then
                lagRestore()
                LAG.applied = false
            else
                break
            end
        end
        LAG.busy = false
    end)
end

local function setAntiLag(on)
    LAG.want = on and true or false
    lagWorker()
end

-- ----- แจ้งเตือนของเกม (PlayerGui.GameUI.Notifications) -----
--  CONFIG.GAME_NOTIF = true  -> เปิด: เกมแสดงแจ้งเตือนตามปกติ
--  CONFIG.GAME_NOTIF = false -> ปิด: ซ่อน (Visible/Enabled = false) และคอยกันไม่ให้เกมเปิดกลับเอง
--  แค่ซ่อน ไม่ได้ลบ ข้อความข้างในยังอัปเดตอยู่ ระบบตรวจ Game Speed (อ่านจาก Notifications.Actions) จึงยังทำงานปกติ
--  (เก็บไว้ในตาราง LAG.notif เพื่อไม่ให้ตัวแปร local ระดับบนสุดเกินขีดจำกัดของ Lua)
LAG.notif = { node = nil, conn = nil, hidden = false }

function LAG.notifProp(node)
    if node:IsA("GuiObject") then return "Visible" end
    if node:IsA("LayerCollector") then return "Enabled" end
    return nil
end

function LAG.notifSet(node, v)
    local prop = LAG.notifProp(node)
    if prop then
        if node[prop] ~= v then pcall(function() node[prop] = v end) end
    else   -- ไม่ใช่ GUI (เช่น Folder): สลับที่ลูกที่เป็น GuiObject แทน
        for _, ch in ipairs(node:GetChildren()) do
            if ch:IsA("GuiObject") and ch.Visible ~= v then pcall(function() ch.Visible = v end) end
        end
    end
end

-- เรียกซ้ำได้ (ลูปเบื้องหลังเรียกทุก 0.5 วิ เผื่อเกมสร้าง GameUI ใหม่)
function LAG.notifApply()
    local N = LAG.notif
    local node = gameUI("Notifications")
    if not node then return end
    if CONFIG.GAME_NOTIF then
        if N.hidden then   -- เพิ่งสลับกลับมาเปิด: คืนค่าครั้งเดียว แล้วปล่อยให้เกมจัดการเอง
            N.hidden = false
            LAG.notifSet(node, true)
        end
        return
    end
    N.hidden = true
    LAG.notifSet(node, false)
    local prop = LAG.notifProp(node)
    if prop and N.node ~= node then   -- ดักตอนเกมสั่งเปิดกลับ -> ซ่อนใหม่ทันที
        if N.conn then pcall(function() N.conn:Disconnect() end) end
        N.node = node
        N.conn = track(node:GetPropertyChangedSignal(prop):Connect(function()
            if alive and not CONFIG.GAME_NOTIF then LAG.notifSet(node, false) end
        end))
    end
end

-- ตอนปิดสคริปต์: ถ้าเราซ่อนไว้ คืนให้เกมแสดงตามเดิม (ค่าที่ตั้งไว้ยังถูกจำไว้ในไฟล์ตั้งค่า)
function LAG.notifRestore()
    local N = LAG.notif
    if not N.hidden then return end
    N.hidden = false
    local node = gameUI("Notifications")
    if node then LAG.notifSet(node, true) end
end

