-- ========== Log ==========
local logBuf, logDirty = {}, false
local function log(msg)
    if not OWN.is then return end   -- ผู้เล่นทั่วไปไม่จด Log
    msg = tostring(msg)
    logBuf[#logBuf + 1] = os.date("%H:%M:%S") .. "  " .. msg
    if #logBuf > 200 then table.remove(logBuf, 1) end
    logDirty = true
end
local function logf(fmt, ...)
    if not OWN.is then return end
    log(string.format(fmt, ...))
end
local dbg
do
    local DEBUG_PRICE = OWN.is   -- จด [P] ลง Log เฉพาะ owner
    function dbg(fmt, ...)
        if DEBUG_PRICE then
            local ok, m = pcall(string.format, fmt, ...)
            log("[P] " .. (ok and m or tostring(fmt)))
        end
    end
end

