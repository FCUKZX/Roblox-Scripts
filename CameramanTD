            pcall(ui.refreshSpeedList)
        end
        if tLog and tLog.Page.Visible and logDirty then
            logDirty = false
            local from = math.max(1, #logBuf - 17)
            local lines = {}
            for i = from, #logBuf do
                local s = logBuf[i]
                if #s > 110 then s = s:sub(1, 110) .. "…" end
                lines[#lines + 1] = s
            end
