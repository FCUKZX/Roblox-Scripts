                -- ราคาที่ก๊อปมาเป็นแค่ค่าเริ่มต้น (ไม่ล็อก)
                local copy = { type = "Upgrade", tid = a.tid, unitRef = a.unitRef, cost = a.cost or 0, costExact = false }
