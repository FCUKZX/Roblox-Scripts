local function parseTimeText(txt)
    txt = tostring(txt or ""):gsub("<[^>]+>", ""):lower()
    local a, b, c = txt:match("(%d+):(%d+):(%d+)")
    if a then return tonumber(a) * 3600 + tonumber(b) * 60 + tonumber(c) end
    a, b = txt:match("(%d+):(%d+)")
    if a then return tonumber(a) * 60 + tonumber(b) end
    local h, m, sec = txt:match("(%d+)%s*h"), txt:match("(%d+)%s*m"), txt:match("(%d+)%s*s")
    if h or m or sec then return (tonumber(h) or 0) * 3600 + (tonumber(m) or 0) * 60 + (tonumber(sec) or 0) end
    return nil
end

