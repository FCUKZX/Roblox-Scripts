-- สถานะแสดงเป็นป๊อปอัปมุมจอ  setStatus(ข้อความ, สี, ไอคอน)  สี = "ok" เขียว / "warn" เหลือง / "bad" แดง
-- ข้อความเดิมที่ต่างกันแค่ตัวเลข จะไม่เด้งซ้ำภายใน 5 วิ และเด้งห่างกันอย่างน้อย 1.2 วิ
local setStatus, fmtNum
do
    local COLORS = {
        ok = Color3.fromRGB(60, 200, 120),
        warn = Color3.fromRGB(230, 170, 60),
        bad = Color3.fromRGB(230, 70, 80),
    }
    local lastKey, lastTime, waiting = nil, -100, nil

    -- 1234567 -> 1,234,567
    function fmtNum(n)
        local txt = string.format("%.0f", tonumber(n) or 0)
        local sign, digits = txt:match("^(-?)(%d+)$")
        if not digits then return txt end
        digits = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
        return sign .. digits
    end

    local function show(text, kind, icon)
        lastTime = os.clock()
        local len = utf8.len(text) or #text
        notify(text, COLORS[kind], math.clamp(3 + len * 0.06, 4, 8), icon)
    end

    function setStatus(text, kind, icon)
        text = tostring(text)
        if ui.dot then
            ui.dot.BackgroundColor3 = isRecording and Color3.fromRGB(230, 70, 80)
                or isPlaying and Color3.fromRGB(60, 200, 120)
                or Color3.fromRGB(130, 130, 150)
        end

        local key = text:gsub("%d[%d,%.]*", "#")
        local now = os.clock()
        if key == lastKey and now - lastTime < 5 then return end
        lastKey = key

        local gap = 1.2 - (now - lastTime)
        if gap > 0 then
            local first = waiting == nil
            waiting = { text, kind, icon }
            if first then
                task.delay(gap, function()
                    local w = waiting
                    waiting = nil
                    if w and alive then show(w[1], w[2], w[3]) end
                end)
            end
            return
        end
        show(text, kind, icon)
    end
end

