local PEX_URL = "https://raw.githubusercontent.com/FCUKZX/Roblox-Scripts/refs/heads/main/PexUI.lua"

local function loadPexUI()
    local src
    local okGet, res = pcall(function() return game:HttpGet(PEX_URL) end)
    if okGet and type(res) == "string" and #res > 0 then src = res end
    if not src and httpRequest then
        local ok2, r = pcall(httpRequest, { Url = PEX_URL, Method = "GET" })
        if ok2 and r and type(r.Body) == "string" and #r.Body > 0 then src = r.Body end
    end
    if not src then return nil, "โหลด PexUI ไม่ได้ (เช็กอินเทอร์เน็ต / executor ต้องรองรับ HttpGet)" end
    local fn, cerr = loadstring(src)
    if not fn then return nil, "PexUI คอมไพล์ไม่ผ่าน: " .. tostring(cerr) end
    local okRun, lib = pcall(fn)
    if not okRun or type(lib) ~= "table" or type(lib.CreateWindow) ~= "function" then
        return nil, "PexUI ทำงานผิดพลาด: " .. tostring(lib)
    end
    return lib
end

local PEX = loadPexUI()
if not PEX then
    shutdown()
    OWN.warn("[PexTD] โหลดหน้าต่างไม่สำเร็จ")
    return
end

