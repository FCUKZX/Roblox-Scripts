-- เวฟปัจจุบัน จาก PlayerGui.GameUI.Stats.Wave  คืน เลขเวฟ, ข้อความดิบ  (อ่านไม่ได้ = nil)
-- รองรับข้อความแบบ "Wave 12" / "Wave 12/50" / "12/50" / "12"
local function getWave()
    local obj = gameUI("Stats", "Wave")
    if not obj then return nil end
    local ok, txt = pcall(function()
        if obj:IsA("ValueBase") then return tostring(obj.Value) end
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then return obj.Text end
        for _, d in ipairs(obj:GetDescendants()) do
            if (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) and d.Text:find("%d") then
                return d.Text
            end
        end
    end)
    if not ok or type(txt) ~= "string" then return nil end
    local raw = txt
    txt = txt:gsub("<[^>]+>", ""):lower()
    local n = txt:match("wave%D*(%d+)") or txt:match("(%d+)")
    n = tonumber(n)
    if not n then return nil end
    return n, raw
end

-- ปุ่มที่กดได้: ตัวมันเอง > ลูก > พ่อ
local function clickable(obj)
    if obj:IsA("GuiButton") then return obj end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("GuiButton") then return d end
    end
    local p = obj.Parent
    for _ = 1, 3 do
        if p and p:IsA("GuiButton") then return p end
        p = p and p.Parent
    end
    return obj
end

