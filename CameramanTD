local function shutdown()
    if not alive then return end
    alive = false
    setAntiLag(false)   -- เอาของที่ย้ายไว้กลับที่เดิม
    pcall(LAG.notifRestore)   -- คืนแจ้งเตือนของเกมที่ซ่อนไว้
    if LAG.priv then pcall(LAG.priv.restoreAll) end   -- คืนชื่อ / หน้าตาตัวละคร
    isPlaying = false
    isRecording = false
    playToken = playToken + 1
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    if MONEY.sig then pcall(function() MONEY.sig:Disconnect() end) end
    if ui.win then
        pcall(function()
            if ui.win.Destroy then ui.win:Destroy() end
        end)
    end
end
