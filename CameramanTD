        Callback = function()
            if editBlocked() then return end
            local sel = ui.editSel
            local a = sel and recordedActions[sel]
            local ref
            if a and a.type == "Place" then
                ref = sel
            elseif TD.isRef(a) and a.unitRef then
                ref = a.unitRef
            end
            if not ref then
                notify("เลือกแถววางยูนิตหรืออัปเกรดก่อน", PT.Warn)
                return
            end
            local pos = sel + 1
            insertAction(pos, {
                type = "Sell", tid = recordedActions[ref].tid, unitRef = ref, cost = 0, costExact = true,
            })
            ui.editSel = pos
            ui.refreshAll()
        end,
    })

    ui.targetBox = sMove:Input({
        Title = "เป้าหมายอัปเกรด/ขาย (# ของ Place)", Placeholder = "เลือกแถวอัปเกรดหรือขายก่อน",
        Callback = function(box)
            if editBlocked() then box.Text = "" return end
            local n = tonumber(box.Text)
            box.Text = ""
            local a = ui.editSel and recordedActions[ui.editSel]
            if not TD.isRef(a) then
                notify("เลือกแถวอัปเกรดหรือขายก่อน", PT.Warn)
                return
            end
            n = n and math.floor(n)
            local t = n and recordedActions[n]
            if not t or t.type ~= "Place" then
                notify("เลข # นั้นไม่ใช่แถว Place", PT.Bad)
                return
            end
            a.unitRef = n
            a.tid = t.tid or a.tid
            macroDirty = true
            ui.refreshAll()
        end,
    })
end

-- ลบแถว + แก้เลขอ้างอิง unitRef ของอัปเกรดให้ตรง
local function removeAction(k)
    table.remove(recordedActions, k)
    for _, a in ipairs(recordedActions) do
        if TD.isRef(a) and a.unitRef then
            if a.unitRef == k then a.unitRef = nil
            elseif a.unitRef > k then a.unitRef = a.unitRef - 1 end
        end
    end
    macroDirty = true
end

-- กลุ่มราคาเดียวกัน: Place ชื่อเดียวกัน / อัปเกรดครั้งที่ n ของยูนิตชื่อเดียวกัน
local function costKeyAt(i)
    local a = recordedActions[i]
    if not a then return nil end
    if a.type == "Place" then return "P|" .. tostring(a.name) end
    if a.type ~= "Upgrade" then return nil end   -- ขายไม่มีราคา
    local ref = a.unitRef
    local pa = ref and recordedActions[ref]
    if not pa then return nil end
    local nth = 0
    for k = 1, i do
        local x = recordedActions[k]
        if x.type == "Upgrade" and x.unitRef == ref then nth = nth + 1 end
    end
    return "U|" .. tostring(pa.name) .. "|" .. nth
end

-- แก้ราคาแถว i แล้วปรับแถวอื่นในกลุ่มเดียวกันตาม  คืนจำนวนแถวที่ถูกปรับ
local function shareCost(i)
    local a = recordedActions[i]
    local key = costKeyAt(i)
    if not a or not key then return 0 end
    local others = 0
    for j, b in ipairs(recordedActions) do
        if j ~= i and costKeyAt(j) == key then
            b.cost = a.cost
            b.costExact = true
            others = others + 1
        end
    end
    return others
end

-- วาดแถวแอคชันใหม่ทั้งหมด
ui.refreshEditor = function()
    local keepPos = ui.editList.CanvasPosition
    for _, c in ipairs(ui.editList:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    if ui.editSelTable ~= recordedActions then
        ui.editSel = nil
        ui.editSelTable = recordedActions
    end
    if ui.editSel and not recordedActions[ui.editSel] then ui.editSel = nil end

    if selectedName or #recordedActions > 0 then
        local warn = 0
        for i, a in ipairs(recordedActions) do
            if TD.isRef(a) and a.unitRef and a.unitRef > i then warn = warn + 1 end
        end
        ui.editInfo.Text = string.format("%s | %d แอคชัน%s", selectedName or "(ยังไม่เซฟ)", #recordedActions,
            warn > 0 and (" | ⚠ " .. warn .. " อัปเกรด/ขายอยู่ก่อนวาง") or "")
    else
        ui.editInfo.Text = "ยังไม่ได้โหลดบันทึก"
    end

    for i, a in ipairs(recordedActions) do
        local selected = (i == ui.editSel)
        local f = new("Frame", {
            Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = selected and PT.Accent or PT.Elem,
            BorderSizePixel = 0, LayoutOrder = i,
        }, ui.editList)
        PEX.Corner(f, 7)

        local desc
        if a.type == "Place" then
            desc = string.format("#%d  วาง  %s", i, tostring(a.name))
        else
            local ref = a.unitRef
            local refName = ref and recordedActions[ref] and tostring(recordedActions[ref].name) or ""
            desc = string.format("#%d  %s  %s%s", i, a.type == "Sell" and "ขาย" or "อัป",
                ref and ("→ #" .. ref .. " " .. refName) or "(ไม่มียูนิตอ้างอิง)",
                (ref and ref > i) and " ⚠" or "")
        end
        local pick = new("TextButton", {
            Size = UDim2.new(0.42, 0, 1, 0), BackgroundTransparency = 1, AutoButtonColor = false,
            Text = "  " .. desc, TextColor3 = PT.Text, Font = Enum.Font.Gotham, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
        }, f)
        pick.Activated:Connect(function()
            ui.editSel = (ui.editSel == i) and nil or i
            ui.refreshAll()
        end)

        -- ช่องเวฟ: เลขเวฟที่จะทำแถวนี้ (ว่าง/0 = ไม่รอเวฟ)
        local function waveText()
            local w = tonumber(a.wave) or 0
            return w > 0 and tostring(math.floor(w)) or ""
        end
        local wbox = new("TextBox", {
            Size = UDim2.new(0.13, 0, 0, 22), Position = UDim2.new(0.44, 0, 0.5, -11),
            BackgroundColor3 = PT.Card, TextColor3 = PT.Text, PlaceholderText = "เวฟ", PlaceholderColor3 = PT.Text,
            Font = Enum.Font.GothamMedium, TextSize = 11, Text = waveText(), ClearTextOnFocus = false,
        }, f)
        PEX.Corner(wbox, 5)
        wbox.FocusLost:Connect(function()
            if isPlaying or isRecording then wbox.Text = waveText() return end
            local n = tonumber((wbox.Text:gsub(",", "")):match("%d+"))
            local newWave = (n and n > 0) and math.floor(n) or nil
            if newWave ~= a.wave then
                a.wave = newWave
                macroDirty = true
            end
            wbox.Text = waveText()
        end)

        local function costText()
            if a.type == "Sell" then return "ขาย" end
            if (a.cost or 0) <= 0 and not a.costExact then return "0 ⚠" end
            return tostring(math.floor((a.cost or 0) + 0.5)) .. (a.costExact and " ✓" or "")
        end
        local box = new("TextBox", {
            Size = UDim2.new(0.25, 0, 0, 22), Position = UDim2.new(0.59, 0, 0.5, -11),
            BackgroundColor3 = PT.Card, TextColor3 = PT.Text, Font = Enum.Font.GothamMedium, TextSize = 11,
            Text = costText(), ClearTextOnFocus = false, TextEditable = (a.type ~= "Sell"),
        }, f)
        PEX.Corner(box, 5)
        box.FocusLost:Connect(function()
            if a.type == "Sell" then box.Text = costText() return end
            local n = tonumber((box.Text:gsub(",", "")):match("%d+%.?%d*"))
            if n then
                a.cost = n
                a.costExact = true
                macroDirty = true
                local others = shareCost(i)
                if others > 0 then
                    ui.refreshAll()
                    return
                end
            end
            box.Text = costText()
        end)

        local del = new("TextButton", {
            Size = UDim2.fromOffset(26, 22), Position = UDim2.new(1, -32, 0.5, -11),
            BackgroundColor3 = PT.Bad, Text = "✕", TextColor3 = Color3.new(1, 1, 1),
            Font = Enum.Font.GothamBold, TextSize = 11, AutoButtonColor = true,
        }, f)
        PEX.Corner(del, 5)
        del.Activated:Connect(function()
            if isPlaying or isRecording then return end
            removeAction(i)
            if ui.editSel then
                if ui.editSel == i then ui.editSel = nil
                elseif ui.editSel > i then ui.editSel = ui.editSel - 1 end
            end
            ui.refreshAll()
        end)
    end
    task.defer(function() ui.editList.CanvasPosition = keepPos end)
end

