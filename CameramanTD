--  รอได้สูงสุด GATE_WAIT วินาที (ลอบบี้จะเปิดหน้าต่างหลังรอนี้) เผื่อ GUI ของเกมยังโหลดไม่เสร็จ (เช่นหลังย้ายเซิร์ฟ)
--  ถ้าบัญชีในรายชื่อ (OWNER_NAMES) ปิด "ทำงานเฉพาะตอนอยู่ในเกม" (REQUIRE_VOTE_UI) ในหน้า Settings ไว้ ก็จะข้ามด่านนี้
--  คนนอกรายชื่อข้ามด่านนี้ไม่ได้ (ค่าในไฟล์เซฟไม่มีผล)
-- =====================================================================
do
    local GATE_WAIT = 5
    local needGate = true
    pcall(function()
        if isfile and readfile and isfile("PexSkibidiTD_Settings.json") then
            local d = game:GetService("HttpService"):JSONDecode(readfile("PexSkibidiTD_Settings.json"))
            if OWN.is and type(d) == "table" and d.REQUIRE_VOTE_UI == false then needGate = false end
        end
    end)
    if needGate then
        local lp = game:GetService("Players").LocalPlayer
        local pg = lp and lp:WaitForChild("PlayerGui", 10)
        local found = false
        local t0 = os.clock()
        while pg and os.clock() - t0 < GATE_WAIT do
            local g = pg:FindFirstChild("GameUI")
            if g and g:FindFirstChild("GamemodeVoting") then
                found = true
                break
            end
            task.wait(0.25)
        end
        if not found then
            if game.PlaceId == LOBBY_PLACE_ID then
                OWN.warn("[PexTD] โหมดลอบบี้")
                local okGet, src = pcall(function() return game:HttpGet(LOBBY_URL) end)
                local fn = okGet and type(src) == "string" and loadstring(src)
                if fn then
                    local okRun, err = pcall(fn)
                    if not okRun then OWN.warn("[PexTD] สคริปต์ลอบบี้ทำงานไม่สำเร็จ") end
                else
                    OWN.warn("[PexTD] โหลดสคริปต์ลอบบี้ไม่ได้")
                end
            else
                OWN.warn("[PexTD] ไม่ได้อยู่ในเกม ไม่ทำงาน")
            end
            return
        end
    end
end

