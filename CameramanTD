                -- ราคาที่ก๊อปมาเป็นแค่ค่าเริ่มต้น (ไม่ล็อก)
                local copy = { type = "Upgrade", tid = a.tid, unitRef = a.unitRef, cost = a.cost or 0, costExact = false }
                insertAction(ui.editSel + 1, copy)
                ui.editSel = ui.editSel + 1
                ui.refreshAll()
            end,
        },
    })

    sMove:Action({
        Text = ui.T.addUpgrade, Icon = "plus", Color = PT.Good,
