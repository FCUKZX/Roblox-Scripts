-- วิธี 1: สั่ง connection ของปุ่มโดยตรง (ไม่แตะระบบอินพุต เดินได้ปกติ)
local function clickButton(btn)
    if not btn then return false end
    if not getconnections then
        -- executor มือถือหลายตัวไม่มี getconnections -> ลอง firesignal แทน (ยังไม่ต้องจำลองเมาส์)
        if not firesignal then return false end
        local okf = pcall(function() firesignal(btn.MouseButton1Click) end)
        pcall(function() firesignal(btn.Activated) end)
        return okf
    end
    local fired = false
    for _, sigName in ipairs({ "MouseButton1Click", "Activated", "MouseButton1Down" }) do
        local ok, list = pcall(function() return getconnections(btn[sigName]) end)
        if ok and list then
            for _, c in ipairs(list) do
                pcall(function() c:Fire() end)
                fired = true
            end
        end
        if fired then break end
    end
    return fired
end

-- วิธี 2: จำลองเมาส์คลิกตรงกลางปุ่ม
local function mouseClick(btn)
    if not (VirtualInputManager and btn) then return false end
    if PLAT.mobile() then return false end   -- มือถือ: ห้ามจำลองเมาส์ (รบกวนจอย/นิ้ว)
    local ok = pcall(function()
        local pos, size = btn.AbsolutePosition, btn.AbsoluteSize
        -- ScreenGui ที่ IgnoreGuiInset = true พิกัดเป็นพิกัดจอจริงอยู่แล้ว ห้ามบวก inset (ไม่งั้นคลิกเลื่อนลงไปโดนปุ่มข้างเคียง)
        local gui = btn:FindFirstAncestorWhichIsA("ScreenGui")
        local insetY = (gui and gui.IgnoreGuiInset) and 0 or GuiService:GetGuiInset().Y
        local x = pos.X + size.X / 2
        local y = pos.Y + size.Y / 2 + insetY
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
    return ok
end

-- attempt เลขคี่ = วิธี 1 / เลขคู่ = วิธี 2 (สลับกันเผื่อวิธีใดวิธีหนึ่งไม่ติด)
local function pressObj(obj, tag, attempt)
    local btn = clickable(obj)
    if (attempt or 1) % 2 == 1 then
        if clickButton(btn) then return true end
