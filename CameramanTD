--  โหมดลอบบี้: ถูกเรียกแทนสคริปต์มาโคร เมื่อไม่เจอ GameUI.GamemodeVoting (อยู่หน้าลอบบี้)
--  สุ่มกล่อง Basic Crate: ใส่จำนวนกล่อง + ปุ่มสุ่ม (ทุก 10 กล่อง = 900 Coins เศษกล่องละ 100)
--  คำนวณเงินก่อนสุ่ม ถ้าไม่พอจะไม่สุ่ม  ตำแหน่งเงิน: LocalPlayer.leaderstats.Coins
--  ส่งสรุปเข้า Discord (แก้ไขข้อความเดิม ไม่เด้งซ้ำ) ใช้ลิงก์เดียวกับโหมดในเกม
-- =====================================================================
local function runLobbyMode()
    local Players = game:GetService("Players")
    local RS = game:GetService("ReplicatedStorage")
    local HttpService = game:GetService("HttpService")
    local VirtualUser = game:GetService("VirtualUser")
    local lp = Players.LocalPlayer
    local pg = lp:WaitForChild("PlayerGui")

    local CRATE_NAME = "Basic Crate"
    local PRICE_ONE, PRICE_TEN = 100, 900
    local DEFAULT_URL = "https://discord.com/api/webhooks/1559951960298496121/_xGby0oKhcg9oypwtca8VqnXWf1_eQ8UGqrZA4wYmpYgSMuyJrHHvrU4leHP8nOmkG20"
    local SETTINGS = "PexSkibidiTD_Settings.json"
    local LOBBY_FILE = "PexSkibidiTD_Lobby.json"

    local genv = (getgenv and getgenv()) or _G
    if type(genv.__PexLobby) == "function" then pcall(genv.__PexLobby) end

    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
        or (fluxus and fluxus.request)

    local alive, running = true, false
    local conns = {}
    local st = { opened = 0, spent = 0, rounds = 0, msgId = nil }

    -- โหลดยอดเดิม (ต่อเนื่องแม้รันสคริปต์ใหม่)
    pcall(function()
        if isfile and readfile and isfile(LOBBY_FILE) then
            local d = HttpService:JSONDecode(readfile(LOBBY_FILE))
            if type(d) == "table" and d.user == lp.Name then
                st.opened = tonumber(d.opened) or 0
                st.spent = tonumber(d.spent) or 0
                st.rounds = tonumber(d.rounds) or 0
                st.msgId = type(d.msgId) == "string" and d.msgId or nil
            end
        end
    end)
    local function saveSt()
        if not writefile then return end
        pcall(function()
            writefile(LOBBY_FILE, HttpService:JSONEncode({
                user = lp.Name, opened = st.opened, spent = st.spent, rounds = st.rounds, msgId = st.msgId,
            }))
        end)
    end

    local webhookUrl = DEFAULT_URL
    pcall(function()
        if isfile and readfile and isfile(SETTINGS) then
            local d = HttpService:JSONDecode(readfile(SETTINGS))
            if type(d) == "table" and type(d.WEBHOOK_URL) == "string" and d.WEBHOOK_URL ~= "" then
                webhookUrl = d.WEBHOOK_URL
            end
        end
    end)
    local function baseUrl() return (webhookUrl:gsub("%?.*$", "")) end

    local function fmt(n)
        local txt = string.format("%.0f", tonumber(n) or 0)
        local sign, digits = txt:match("^(-?)(%d+)$")
        if not digits then return txt end
        digits = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
        return sign .. digits
    end

    -- ---------- เงิน ----------
    -- เงินอ่านจาก PlayerGui.HUD.Currencies.Money.CurrencyFrame.AmountLabel (ข้อความ เช่น "1,250" / "1.2K")
    local SUF = { K = 1e3, M = 1e6, B = 1e9, T = 1e12 }
    local function getCoins()
        local ok, txt = pcall(function()
            return pg.HUD.Currencies.Money.CurrencyFrame.AmountLabel.Text
        end)
        if not ok or type(txt) ~= "string" then return nil end
        txt = txt:gsub("<[^>]+>", ""):gsub(",", ""):gsub("%s", "")
        local num, suf = txt:match("(%d+%.?%d*)([KkMmBbTt]?)")
        local n = tonumber(num)
        if not n then return nil end
        if suf ~= "" then n = n * (SUF[suf:upper()] or 1) end
        return n
    end

    -- ---------- Discord ----------
    local function sendReport(note)
        if not httpRequest or webhookUrl == "" then return end
        local coins = getCoins()
        local embed = {
            title = "🎁 สรุปการสุ่มกล่อง | " .. lp.Name,
            color = 15844367,
            fields = {
                { name = "👤 รหัส", value = lp.Name, inline = true },
                { name = "📦 เปิดไปแล้ว", value = fmt(st.opened) .. " กล่อง (" .. st.rounds .. " รอบ)", inline = true },
                { name = "💸 ใช้ Coins ไป", value = fmt(st.spent), inline = true },
                { name = "💰 Coins คงเหลือ", value = coins and fmt(coins) or "-", inline = true },
                { name = "📝 สถานะ", value = note or "-", inline = false },
            },
            footer = { text = "Pex Hub Lobby | อัปเดต " .. os.date("%H:%M:%S") },
        }
        local url, oldId = baseUrl(), st.msgId
        task.spawn(function()
            local body = HttpService:JSONEncode({ embeds = { embed } })
            local headers = { ["Content-Type"] = "application/json" }
            if oldId then
                local ok, res = pcall(httpRequest, { Url = url .. "/messages/" .. oldId, Method = "PATCH", Headers = headers, Body = body })
                local code = ok and type(res) == "table" and (res.StatusCode or res.status_code)
                if ok and type(res) == "table" and (res.Success == true or code == 200) then return end
                pcall(httpRequest, { Url = url .. "/messages/" .. oldId, Method = "DELETE" })
            end
            local ok, res = pcall(httpRequest, { Url = url .. "?wait=true", Method = "POST", Headers = headers, Body = body })
            local newId
            if ok and type(res) == "table" and res.Body then
                local okJ, d = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if okJ and type(d) == "table" and d.id then newId = tostring(d.id) end
            end
            st.msgId = newId
            saveSt()
        end)
    end

    -- ---------- Anti-AFK ----------
    conns[#conns + 1] = lp.Idled:Connect(function()
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)
    end)

    -- ---------- โหลด PexUI ----------
    local PEX_URL = "https://raw.githubusercontent.com/FCUKZX/Roblox-Scripts/refs/heads/main/PexUI.lua"
    local PEX
    do
        local src
        local okGet, res = pcall(function() return game:HttpGet(PEX_URL) end)
        if okGet and type(res) == "string" and #res > 0 then src = res end
        if not src and httpRequest then
            local ok2, r = pcall(httpRequest, { Url = PEX_URL, Method = "GET" })
            if ok2 and r and type(r.Body) == "string" and #r.Body > 0 then src = r.Body end
        end
        local fn = src and loadstring(src)
        local okRun, lib = false, nil
        if fn then okRun, lib = pcall(fn) end
        if okRun and type(lib) == "table" and type(lib.CreateWindow) == "function" then PEX = lib end
    end
    if not PEX then
        warn("[PexTD] โหลด PexUI ไม่ได้ (โหมดลอบบี้)")
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        return
    end
    local PT = PEX.Theme

    local function shutdown()
        alive = false
        running = false
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        genv.__PexLobby = nil
    end
    genv.__PexLobby = shutdown

    local win = PEX:CreateWindow({
        Title = "Pex Hub", Subtitle = "Lobby", Icon = "package", Name = "PexHubLobby",
        OnClose = shutdown,
    })
    local function notify(text, color, icon)
        pcall(function() win:Notify({ Text = tostring(text), Color = color, Duration = 3, Icon = icon }) end)
    end

    local tab = win:AddTab({ Name = "Crate", Category = "Lobby", Icon = "package", Color = PT.Accent })
    local sel = tab:Section({ Title = "สุ่มกล่อง (Basic Crate)", Desc = "ใส่จำนวนกล่อง แล้วกดสุ่ม (ทีละ 10 เศษทีละ 1) | 1 กล่อง = 100 Coins | ทุก 10 กล่อง คิดชุดละ 900 (ลด 10%)", Icon = "gift", Color = PT.Orange })
    local lblCoins = sel:Label({ Text = "Coins: -", TextSize = 13, Color = PT.Text })
    local countBox = sel:Input({ Title = "จำนวนที่จะสุ่ม (กล่อง)", Default = "10", Placeholder = "เช่น 10, 50, 7" })
    local lblCalc = sel:Label({ Text = "-", TextSize = 12, Color = PT.Text })
    local lblInfo = sel:Label({ Text = "พร้อมสุ่ม", TextSize = 12, Color = PT.Text })

    local function getCount()
        local n = tonumber(countBox and countBox.Text) or 1
        return math.clamp(math.floor(n), 1, 9999)
    end

    -- คำนวณราคา: ทุก 10 กล่อง = 900 / เศษที่เหลือกล่องละ 100
    local function calcCost(n)
        local packs, single = math.floor(n / 10), n % 10
        return packs * PRICE_TEN + single * PRICE_ONE, packs, single
    end

    local function setInfo(t) lblInfo.Text = t end

    local function summon(count)
        local rf = RS:FindFirstChild("ModuleLoader")
        rf = rf and rf:FindFirstChild("Shared")
        rf = rf and rf:FindFirstChild("Network")
        rf = rf and rf:FindFirstChild("RemoteFunction")
        rf = rf and rf:FindFirstChild("SummonTowers")
        if not rf then return false, "ไม่เจอ RemoteFunction.SummonTowers" end
        return pcall(function() return rf:InvokeServer(CRATE_NAME, count) end)
    end

    -- ยิงสุ่ม 1 ครั้ง (count = 10 หรือ 1) คืนค่า true ถ้าสำเร็จ
    local function summonOnce(count, cost)
        local coins = getCoins()
        if not coins then return false, "อ่านเงินไม่ได้ (HUD.Currencies.Money)", true end
        if coins < cost then
            return false, string.format("เงินไม่พอ (มี %s ต้องใช้ %s)", fmt(coins), fmt(cost)), true
        end
        local ok, res = summon(count)
        local replied = ok and res ~= nil and res ~= false
        local dropped = false
        local t0 = os.clock()
        -- เซิร์ฟเวอร์ตอบแล้ว = ไปต่อทันที / ไม่ตอบ = รอดูเงินลดสูงสุด 2.5 วิ
        while ok and not replied and os.clock() - t0 < 2.5 do
            local now = getCoins()
            if now and now <= coins - cost * 0.5 then dropped = true break end
            task.wait(0.1)
        end
        if ok and (dropped or replied) then return true end
        return false, tostring(res), false
    end

    local function roll()
        if running then notify("กำลังสุ่มอยู่ รอให้เสร็จก่อน", PT.Warn, "hourglass") return end
        local n = getCount()
        local cost, packs, single = calcCost(n)
        local coins = getCoins()
        if not coins then notify("อ่านเงินไม่ได้", PT.Warn, "x") return end
        if coins < cost then
            local msg = string.format("เงินไม่พอ สุ่ม %d กล่องต้องใช้ %s (มี %s ขาดอีก %s)", n, fmt(cost), fmt(coins), fmt(cost - coins))
            setInfo(msg)
            notify(msg, PT.Warn, "x")
            return
        end

        running = true
        task.spawn(function()
            -- สุ่มทีละ 10 กล่อง (900) จนเหลือเศษ แล้วสุ่มทีละ 1 กล่อง (100) จนครบจำนวน
            local opened, spent, stopMsg, fails = 0, 0, nil, 0
            while alive and opened < n do
                local count = (n - opened >= 10) and 10 or 1
                local price = (count == 10) and PRICE_TEN or PRICE_ONE
                setInfo(string.format("กำลังสุ่ม... %d/%d กล่อง", opened, n))
                local ok, err, fatal = summonOnce(count, price)
                if ok then
                    fails = 0
                    opened = opened + count
                    spent = spent + price
                    st.rounds = st.rounds + 1
                    st.opened = st.opened + count
                    st.spent = st.spent + price
                    saveSt()
                else
                    fails = fails + 1
                    if fatal or fails >= 3 then
                        stopMsg = fatal and err or ("สุ่มไม่สำเร็จติดกัน 3 ครั้ง (" .. tostring(err) .. ")")
                        break
                    end
                end
            end
            running = false
            local msg = stopMsg and string.format("หยุด: %s | สุ่มได้ %d/%d กล่อง", stopMsg, opened, n)
                or string.format("สุ่มเสร็จ %d กล่อง (ใช้ %s Coins)", opened, fmt(spent))
            setInfo(msg)
            notify(msg, stopMsg and PT.Warn or PT.Good, stopMsg and "x" or "trophy")
            if opened > 0 then sendReport(msg) end
        end)
    end

    -- ใส่จำนวนให้พอดีกับเงินทั้งหมด (ชุด 10 = 900 ก่อน แล้วเศษกล่องละ 100)
    local function fitMax()
        local coins = getCoins()
        if not coins then notify("อ่านเงินไม่ได้", PT.Warn, "x") return end
        local packs = math.floor(coins / PRICE_TEN)
        local single = math.floor((coins - packs * PRICE_TEN) / PRICE_ONE)
        local n = packs * 10 + single
        if n < 1 then notify("เงินไม่พอสุ่มแม้แต่ 1 กล่อง", PT.Warn, "x") return end
        countBox.Text = tostring(n)
        notify(string.format("ตั้งจำนวน %d กล่อง (ใช้ %s Coins)", n, fmt((calcCost(n)))), PT.Good, "check")
    end

    sel:Action({ Text = "💰 ใส่จำนวนพอดีกับเงินทั้งหมด", Icon = "coins", Color = PT.Blue, Callback = fitMax })
    sel:Action({ Text = "🎲 สุ่มเลย", Icon = "boxes", Color = PT.Purple, Callback = roll })
    sel:Action({
        Text = "รีเซ็ตยอดสถิติ", Icon = "trash", Color = PT.Elem,
        Callback = function()
            st.opened, st.spent, st.rounds, st.msgId = 0, 0, 0, nil
            saveSt()
            notify("ล้างยอดแล้ว", PT.Good, "check")
        end,
    })

    task.spawn(function()
        while alive do
            local c = getCoins()
            local n = getCount()
            local cost, packs, single = calcCost(n)
            lblCoins.Text = "Coins: " .. (c and fmt(c) or "-")
            local saved = n * PRICE_ONE - cost
            local status = (c == nil and "") or (c >= cost and "✅ เงินพอ" or ("❌ ขาดอีก " .. fmt(cost - c)))
            lblCalc.Text = string.format("สุ่ม %d กล่อง = %d ชุด x%s + %d กล่อง x%s | รวม %s Coins (ประหยัด %s) %s",
                n, packs, fmt(PRICE_TEN), single, fmt(PRICE_ONE), fmt(cost), fmt(saved), status)
            task.wait(0.5)
        end
    end)
    notify("โหมดลอบบี้: กดปุ่มสุ่มได้เลย", PT.Good, "package")
end

-- =====================================================================
--  ด่านแรกสุด: ไม่เจอ PlayerGui.GameUI.GamemodeVoting "จริงๆ" = สคริปต์ไม่ทำงานอะไรเลย
--  (ไม่โหลด UI / ไม่ hook / ไม่สร้างลูปใดๆ) -- อยู่ลอบบี้ก็จบตรงนี้
--  รอได้สูงสุด GATE_WAIT วินาที (ลอบบี้จะเปิดหน้าต่างหลังรอนี้) เผื่อ GUI ของเกมยังโหลดไม่เสร็จ (เช่นหลังย้ายเซิร์ฟ)
--  ถ้าปิด "ทำงานเฉพาะตอนอยู่ในเกม" (REQUIRE_VOTE_UI) ในหน้า Settings ไว้ ก็จะข้ามด่านนี้
-- =====================================================================
do
    local GATE_WAIT = 5
    local needGate = true
    pcall(function()
        if isfile and readfile and isfile("PexSkibidiTD_Settings.json") then
            local d = game:GetService("HttpService"):JSONDecode(readfile("PexSkibidiTD_Settings.json"))
            if type(d) == "table" and d.REQUIRE_VOTE_UI == false then needGate = false end
        end
    end)
    if needGate then
        local lp = game:GetService("Players").LocalPlayer
        local pg = lp and lp:WaitForChild("PlayerGui", 10)
        local found = false
        local t0 = os.clock()
        while pg and os.clock() - t0 < GATE_WAIT do
            local g = pg:FindFirstChild("GameUI")
            if g and g:FindFirstChild("GamemodeVoting") then
                found = true
                break
            end
            task.wait(0.25)
        end
        if not found then
            warn("[PexTD] ไม่เจอ GameUI.GamemodeVoting -> เข้าโหมดลอบบี้ (สุ่มกล่อง)")
            runLobbyMode()
            return
        end
    end
end

